---
import Base from '../layouts/Base.astro';
import WhatsAppIcon from '../components/WhatsAppIcon.astro';
import WhatsAppCTA from '../components/WhatsAppCTA.astro';
import HeroPhotoShowcase from '../components/HeroPhotoShowcase.astro';
import HeroCentered from '../components/HeroCentered.astro';
import CalculadoraComida from '../components/CalculadoraComida.astro';
import FaqSection from '../components/FaqSection.astro';
import ReviewsSection from '../components/ReviewsSection.astro';
import fluffy from '../data/fluffy.json';
import faqsData from '../data/faqs.json';

const { site, variedades } = fluffy;
const waHref = `https://wa.me/${site.whatsapp.replace(/[^\d]/g, '')}`;
---

<Base
  title="Dinastía Bulldog Fluffy | Criadero de Bulldog Francés Fluffy con Pedigree"
  description="Criadero especializado en Bulldog Francés Fluffy de raza pura. Variedades Fluffy Blue, Visual Isabella, Lilac, Cocoa y Merlé con registro AKC, FCI y garantía genética."
>
  <section class="hero hero--bento-luxury">
    <!-- Ambient Backdrop Light Orbs -->
    <div class="hero-orb hero-orb-gold"></div>
    <div class="hero-orb hero-orb-emerald"></div>

    <div class="wrap">
      <!-- CONMUTADOR INTERACTIVO DE HEROS -->
      <div class="hero-switcher-wrapper">
        <div class="hero-switcher-bar" role="tablist" aria-label="Seleccionar variante de Hero">
          <button type="button" class="hero-switch-btn active" id="btn-hero-v1" data-vista="v1" role="tab" aria-selected="true">
            <span class="switch-icon">📷</span>
            <span>Vista 1: Fotografía Real</span>
          </button>
          <button type="button" class="hero-switch-btn" id="btn-hero-v2" data-vista="v2" role="tab" aria-selected="false">
            <span class="switch-icon">🔤</span>
            <span>Vista 2: Tipográfica Centrada</span>
          </button>
        </div>
      </div>

      <!-- VISTA 1: HERO CON FOTOGRAFÍA REAL E INTERACTIVA -->
      <div id="hero-vista-1" class="hero-vista-panel">
        <div class="hero-grid">
          <!-- Columna Izquierda: Editorial Head & Conversion -->
          <div class="hero-content">
            <div class="hero-kicker-pill">
              <span class="pulse-dot-gold"></span>
              <span class="kicker-text">✨ CRIADERO DE ALTA COSTURA · AKC & FCI</span>
            </div>

            <h1 class="hero-title">
              Crianza de Elite en <span class="hero-title-highlight">Bulldog Francés Fluffy</span>
            </h1>

            <p class="lead hero-lead">
              Exclusividad genética, belleza insuperable y salud garantizada por 2 años. Especialistas en el gen Fluffy de pelo largo en variedades exóticas con pedigree internacional y protocolo de entrega VIP en cabina.
            </p>

            <!-- CLÚSTER DE BOTONES DE ACCIÓN EXCLUSIVOS -->
            <div class="hero-action-dock">
              <a class="btn-dock-primary" href="/precios-bulldog-fluffy/">
                <span class="dock-icon">✦</span>
                <span class="dock-text">Ver Cachorros & Precios 2026</span>
                <span class="dock-arrow">→</span>
              </a>

              <a class="btn-dock-whatsapp" href={waHref} target="_blank" rel="noopener" aria-label="Consultar por WhatsApp">
                <WhatsAppIcon size={18} class="dock-wa-icon" />
                <span>WhatsApp Directo</span>
              </a>

              <a class="btn-dock-ghost" href="/destinos/">
                <span class="dock-pin">📍</span>
                <span>Envíos a +100 Ciudades</span>
              </a>
            </div>

            <!-- EEAT Medical Trust Bar -->
            <div class="hero-trust-bar">
              <div class="trust-badge-item">
                <span class="trust-icon">📜</span>
                <span>Pedigree Oficial AKC / FCI</span>
              </div>
              <div class="trust-badge-item">
                <span class="trust-icon">🧬</span>
                <span>Test ADN 100% Pura Raza</span>
              </div>
              <div class="trust-badge-item">
                <span class="trust-icon">🏥</span>
                <span>Registro M.V. 14892</span>
              </div>
            </div>
          </div>

          <!-- Columna Derecha: Tarjeta Bento Flat con Fotos Reales -->
          <div class="hero-right-column">
            <HeroPhotoShowcase />
          </div>
        </div>

        <!-- Bento Metrics Grid -->
        <div class="hero-stats-bento">
          <div class="stat-card">
            <div class="stat-num">01 / VARIEDADES</div>
            <div class="stat-val">5</div>
            <div class="stat-label">Variedades Exóticas de Colección</div>
          </div>
          <div class="stat-card">
            <div class="stat-num">02 / COBERTURA</div>
            <div class="stat-val">+100</div>
            <div class="stat-label">Ciudades con Entrega Aérea</div>
          </div>
          <div class="stat-card">
            <div class="stat-num">03 / SALUD Y ADN</div>
            <div class="stat-val">100%</div>
            <div class="stat-label">Garantía Genética Certificada M.V.</div>
          </div>
          <div class="stat-card">
            <div class="stat-num">04 / DESTINOS</div>
            <div class="stat-val">+12</div>
            <div class="stat-label">Países con Envíos VIP en Cabina</div>
          </div>
        </div>
      </div>

      <!-- VISTA 2: HERO CENTRADO TIPOGRÁFICO MINIMALISTA -->
      <div id="hero-vista-2" class="hero-vista-panel" style="display: none;">
        <HeroCentered />
      </div>
    </div>
  </section>

  <script is:inline>
    function initHeroSwitcher() {
      const btnV1 = document.getElementById('btn-hero-v1');
      const btnV2 = document.getElementById('btn-hero-v2');
      const panelV1 = document.getElementById('hero-vista-1');
      const panelV2 = document.getElementById('hero-vista-2');

      if (!btnV1 || !btnV2 || !panelV1 || !panelV2) return;

      function switchVista(vista) {
        if (vista === 'v1') {
          btnV1.classList.add('active');
          btnV1.setAttribute('aria-selected', 'true');
          btnV2.classList.remove('active');
          btnV2.setAttribute('aria-selected', 'false');

          panelV2.style.display = 'none';
          panelV1.style.display = 'block';

          if (typeof window.gsap !== 'undefined') {
            window.gsap.fromTo(panelV1, { opacity: 0, y: 15 }, { opacity: 1, y: 0, duration: 0.45, ease: 'power2.out' });
          }
        } else {
          btnV2.classList.add('active');
          btnV2.setAttribute('aria-selected', 'true');
          btnV1.classList.remove('active');
          btnV1.setAttribute('aria-selected', 'false');

          panelV1.style.display = 'none';
          panelV2.style.display = 'block';

          if (typeof window.gsap !== 'undefined') {
            window.gsap.fromTo(panelV2, { opacity: 0, y: 15 }, { opacity: 1, y: 0, duration: 0.45, ease: 'power2.out' });
          }
        }
      }

      btnV1.addEventListener('click', () => switchVista('v1'));
      btnV2.addEventListener('click', () => switchVista('v2'));
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initHeroSwitcher);
    } else {
      initHeroSwitcher();
    }
  </script>

  <main class="wrap">
    <!-- SECCIÓN DE CIUDADES DESTACADAS -->
    <h2 id="cobertura" class="reveal">📍 Entregas y Cobertura por Ciudad</h2>
    <p class="lead reveal">Realizamos envíos seguros con niñera aérea en cabina climatizada a más de 100 ciudades. Haz clic en tu ciudad para conocer el protocolo de llegada y la historia local.</p>
    
    <div class="grid reveal" style="grid-template-columns: repeat(auto-fill, minmax(250px, 1fr)); gap: 16px;">
      {[
        { city: 'Bogotá', country: 'Colombia', airport: 'El Dorado (BOG)', slug: 'bulldog-frances-fluffy-bogota' },
        { city: 'Medellín', country: 'Colombia', airport: 'José María Córdova (MDE)', slug: 'bulldog-frances-fluffy-medellin' },
        { city: 'Cali', country: 'Colombia', airport: 'Alfonso Bonilla (CLO)', slug: 'bulldog-frances-fluffy-cali' },
        { city: 'Barranquilla', country: 'Colombia', airport: 'Ernesto Cortissoz (BAQ)', slug: 'bulldog-frances-fluffy-barranquilla' },
        { city: 'CDMX', country: 'México', airport: 'Benito Juárez (MEX)', slug: 'bulldog-frances-fluffy-cdmx' },
        { city: 'Guadalajara', country: 'México', airport: 'Guadalajara (GDL)', slug: 'bulldog-frances-fluffy-guadalajara' },
        { city: 'Monterrey', country: 'México', airport: 'Monterrey (MTY)', slug: 'bulldog-frances-fluffy-monterrey' },
        { city: 'Buenos Aires', country: 'Argentina', airport: 'Ezeiza (EZE)', slug: 'bulldog-frances-fluffy-buenos-aires' },
        { city: 'Santiago', country: 'Chile', airport: 'Arturo Merino (SCL)', slug: 'bulldog-frances-fluffy-santiago' },
        { city: 'Lima', country: 'Perú', airport: 'Jorge Chávez (LIM)', slug: 'bulldog-frances-fluffy-lima' },
        { city: 'São Paulo', country: 'Brasil', airport: 'Guarulhos (GRU)', slug: 'bulldog-frances-fluffy-sao-paulo' },
        { city: 'Panamá', country: 'Panamá', airport: 'Tocumen (PTY)', slug: 'bulldog-frances-fluffy-panama' }
      ].map((item) => (
        <a class="card" href={`/${item.slug}/`} style="padding: 18px;">
          <div class="card-header-icon" style="margin-bottom: 4px;">
            <span style="font-size: 1.2rem;">📍</span>
            <strong style="color: var(--amber); font-size: 0.95rem;">{item.city}</strong>
          </div>
          <p style="font-size: 0.8rem; margin: 2px 0; color: var(--ink-soft);">{item.country} · Aeropuerto {item.airport}</p>
          <span class="btn-card-cta">Ver Protocolo de Envío →</span>
        </a>
      ))}
    </div>

    <div style="text-align: center; margin-top: 24px;">
      <a class="btn btn--secondary" href="/destinos/">Ver la Lista Completa de +100 Ciudades →</a>
    </div>

    <!-- SECCIÓN DE VARIEDADES EXÓTICAS -->
    <h2 id="variedades" class="reveal">Variedades de Bulldog Francés Fluffy</h2>
    <p class="lead reveal">Crianza de linajes puros en los colores más exclusivos y codiciados del mundo.</p>
    
    <div class="grid reveal" style="grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));">
      {variedades.map((v) => (
        <a class="card" href={`/colores/${v.slug}/`}>
          <img src={`/images/variedades/${v.slug}.jpg`} alt={`Bulldog Francés ${v.nombre}`} loading="lazy" />
          <div class="card-body">
            <h3>{v.nombre}</h3>
            <p>{v.resumen}</p>
            <div style="margin-top: 12px; font-weight: 700; color: var(--amber);">
              Desde: ${v.variantes?.[0]?.precioUSD?.toLocaleString() || '2,300'} USD
            </div>
            <span class="btn-card-cta" style="margin-top: 10px;">Ver Ficha Técnica y Fotos →</span>
          </div>
        </a>
      ))}
    </div>

    <!-- RESEÑAS DE CLIENTES REALES -->
    <ReviewsSection />

    <!-- CALCULADORA DE ALIMENTACIÓN -->
    <CalculadoraComida />

    <!-- PREGUNTAS FRECUENTES -->
    <FaqSection title="Preguntas Frecuentes sobre el Bulldog Francés Fluffy" faqs={faqsData.general} />

    <WhatsAppCTA 
      title="¿Listo para recibir a tu nuevo Bulldog Francés Fluffy?"
      subtitle="Contáctanos hoy por WhatsApp. Te enviamos fotos y videos en tiempo real de los cachorros disponibles y coordinamos la entrega con niñera aérea."
    />
  </main>
</Base>
