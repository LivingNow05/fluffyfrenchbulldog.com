---
import Base from '../../layouts/Base.astro';
import PriceTable from '../../components/PriceTable.astro';
import FaqSection from '../../components/FaqSection.astro';
import WhatsAppCTA from '../../components/WhatsAppCTA.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import ReviewsSection from '../../components/ReviewsSection.astro';
import fluffy from '../../data/fluffy.json';
import faqsData from '../../data/faqs.json';

import { MovingBorderBox } from '../../components/colores/MovingBorderBox';
import { ColorHoverGrid } from '../../components/colores/ColorHoverGrid';
import { ColorBentoGrid } from '../../components/colores/ColorBentoGrid';
import { Button as MovingBorderButton } from '../../components/ui/moving-border';

export function getStaticPaths() {
  return fluffy.variedades.map((v) => ({
    params: { slug: v.slug },
    props: { v },
  }));
}

const { v } = Astro.props;
const faqs = (faqsData.variedades as Record<string, { q: string; a: string }[]>)[v.slug] ?? [];

const usd = (n: number) => `$${n.toLocaleString('en-US')} USD`;

const minUSD = Math.min(...v.variantes.map((v2) => v2.precioUSD));
const maxUSD = Math.max(...v.variantes.map((v2) => v2.precioUSD));

const rangoUSD = minUSD === maxUSD ? usd(minUSD) : `${usd(minUSD)} - ${usd(maxUSD)}`;

const specLabels: Record<string, string> = {
  peso: 'Peso adulto',
  esperanzaVida: 'Esperanza de vida',
  pelaje: 'Pelaje y Genética',
  temperamento: 'Temperamento',
  nivelActividad: 'Nivel de actividad',
  apartamento: 'Apto para apartamento',
  clima: 'Adaptación al clima',
};

const specIcons: Record<string, string> = {
  peso: '⚖️',
  esperanzaVida: '❤️',
  pelaje: '🧬',
  temperamento: '🎭',
  nivelActividad: '🏃',
  apartamento: '🏡',
  clima: '🌡️',
};

const productSchema = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: v.nombre,
  description: v.resumen,
  image: `${fluffy.site.domain}/images/variedades/${v.slug}.jpg`,
  category: 'Mascotas > Perros',
  brand: { '@type': 'Brand', name: fluffy.site.brand },
  offers: {
    '@type': 'AggregateOffer',
    priceCurrency: 'USD',
    lowPrice: minUSD,
    highPrice: maxUSD,
    offerCount: v.variantes.length,
    availability: 'https://schema.org/PreOrder',
    seller: { '@id': `${fluffy.site.domain}/#criadero` },
  },
};

const otras = fluffy.variedades.filter((r) => r.slug !== v.slug).slice(0, 4);

const otrasFormatted = otras.map((r) => {
  const minVal = Math.min(...r.variantes.map((v2) => v2.precioUSD));
  return {
    slug: r.slug,
    nombre: r.nombre,
    nombreCorto: r.nombreCorto,
    minPrecioUSD: minVal,
    tagline: r.perfil.tagline,
  };
});
---

<Base
  title={`${v.nombre}: Precio, Colores y Características 2026`}
  description={`¿Buscas un ${v.nombreCorto}? En 2026 cuesta desde ${rangoUSD} USD. Conoce sus cuidados, temperamento, pedigree AKC y garantía genética de salud.`}
  schema={[productSchema]}
  variedad={v.nombre}
>
  <main class="wrap">
    <Breadcrumbs
      items={[
        { nombre: 'Inicio', url: '/' },
        { nombre: 'Precios', url: '/precios-bulldog-fluffy/' },
        { nombre: v.nombreCorto },
      ]}
    />

    <div class="breed-hero">
      <div>
        <h1 style="margin-bottom: 20px;">{v.titulo}</h1>

        <MovingBorderBox client:visible borderGradient="#9333ea">
          <p class="m-0">
            <strong class="text-purple-400">Respuesta rápida:</strong> un <strong class="text-white">{v.nombre}</strong> de Dinastía cuesta <strong class="text-purple-400">{rangoUSD}</strong> en 2026, según la variante (portador o visual) y derechos de cría. Incluye registro de pedigree internacional, microchip ISO, vacunas completas y garantía médica por escrito.
          </p>
        </MovingBorderBox>

        <p class="lead" style="margin-top: 20px;">{v.resumen}</p>
      </div>
      <div class="breed-hero-image">
        <img src={`/images/variedades/${v.slug}.jpg`} alt={`Bulldog Francés Fluffy variedad ${v.nombre}`} class="reveal rounded-2xl border border-[#27272a]" />
      </div>
    </div>

    <h2>🏛️ Precios del {v.nombreCorto} (Edición 2026)</h2>
    <PriceTable filas={v.variantes} caption={`Tabla de precios para el ${v.nombre}`} />

    <h2>📊 Características de la variedad {v.nombreCorto}</h2>
    <ColorBentoGrid
      caracteristicas={v.caracteristicas}
      specLabels={specLabels}
      specIcons={specIcons}
    />

    <h2>🎨 Detalles de la variedad y cuidados</h2>
    <p style="font-size: 1.1rem; line-height: 1.7; margin-bottom: 50px;">{v.contenido}</p>

    <FaqSection faqs={faqs} titulo={`❓ Preguntas frecuentes sobre el ${v.nombreCorto}`} />

    <div class="flex justify-center my-8">
      <a
        href={`https://wa.me/573000000000?text=Hola,%20busco%20información%20sobre%20el%20Bulldog%20Fluffy%20${encodeURIComponent(v.nombreCorto)}`}
        target="_blank"
        rel="noopener noreferrer"
        class="bg-rose-600 hover:bg-rose-700 text-white font-extrabold text-base px-8 py-4 border border-rose-500 rounded-2xl cursor-pointer text-decoration-none transition-colors duration-200 flex items-center justify-center gap-3 shadow-md"
      >
        <span>📱 Consultar Disponibilidad de {v.nombreCorto} por WhatsApp</span>
      </a>
    </div>

    <WhatsAppCTA contexto={`un cachorro ${v.nombre}`} />

    <ReviewsSection />

    <h2>🐾 Otras variedades exclusivas</h2>
    <ColorHoverGrid client:visible variedades={otrasFormatted} />
  </main>
</Base>
