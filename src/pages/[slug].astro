---
import fs from 'node:fs';
import path from 'node:path';
import Base from '../layouts/Base.astro';
import PriceTable from '../components/PriceTable.astro';
import FaqSection from '../components/FaqSection.astro';
import WhatsAppCTA from '../components/WhatsAppCTA.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import ReviewsSection from '../components/ReviewsSection.astro';
import CalculadoraComida from '../components/CalculadoraComida.astro';
import ShippingAccordion from '../components/ShippingAccordion.astro';
import QuizModal from '../components/QuizModal.astro';
import fluffy from '../data/fluffy.json';
import faqsData from '../data/faqs.json';

import { CardContainer, CardBody, CardItem } from '../components/ui/3d-card';
import { Button as MovingBorderButton } from '../components/ui/moving-border';
import { MovingBorderBox } from '../components/colores/MovingBorderBox';
import { EEATMedicalHoverGrid } from '../components/destinos/EEATMedicalHoverGrid';
import { CityVarietyHoverGrid } from '../components/destinos/CityVarietyHoverGrid';

export function getStaticPaths() {
  function parseRow(rowStr: string): string[] {
    const values: string[] = [];
    let cur = '';
    let inQuotes = false;
    for (let i = 0; i < rowStr.length; i++) {
      const char = rowStr[i];
      const nextChar = rowStr[i + 1];
      if (char === '"') {
        if (inQuotes && nextChar === '"') {
          cur += '"';
          i++;
        } else {
          inQuotes = !inQuotes;
        }
      } else if (char === ',' && !inQuotes) {
        values.push(cur);
        cur = '';
      } else {
        cur += char;
      }
    }
    values.push(cur);
    return values;
  }

  function parseCSV(text: string) {
    const lines: string[] = [];
    let cur = '';
    let inQuotes = false;

    for (let i = 0; i < text.length; i++) {
      const char = text[i];
      const nextChar = text[i + 1];
      if (char === '"') {
        cur += '"';
        if (inQuotes && nextChar === '"') {
          cur += '"';
          i++;
        } else {
          inQuotes = !inQuotes;
        }
      } else if (char === '\n' && !inQuotes) {
        lines.push(cur);
        cur = '';
      } else if (char === '\r' && !inQuotes) {
        // ignore
      } else {
        cur += char;
      }
    }
    if (cur.trim()) lines.push(cur);

    const header = parseRow(lines[0]).map((h) => h.trim());
    const rows: Record<string, string>[] = [];

    for (let i = 1; i < lines.length; i++) {
      const values = parseRow(lines[i]);
      if (values.length >= 5) {
        const obj: Record<string, string> = {};
        header.forEach((h, idx) => {
          obj[h] = values[idx] ? values[idx].trim() : '';
        });
        rows.push(obj);
      }
    }
    return rows;
  }

  const fluffyCsvPath = path.resolve(process.cwd(), 'dataset_fluffy_stories.csv');
  const fallbackCsvPath = path.resolve(process.cwd(), 'dataset_enriched_stories.csv');

  let rawText = '';
  let isFluffyCsv = false;
  try {
    if (fs.existsSync(fluffyCsvPath)) {
      rawText = fs.readFileSync(fluffyCsvPath, 'utf-8');
      isFluffyCsv = true;
    } else {
      rawText = fs.readFileSync(fallbackCsvPath, 'utf-8');
    }
  } catch (e) {
    console.error('Error al leer CSV:', e);
  }

  const rawRows = parseCSV(rawText);

  return rawRows.map((row) => {
    const rawSlug = row['URL Final (Slug)'] || 'bulldog-frances-fluffy-bogota';
    const cleanSlug = rawSlug.replace(/^maine-coon-/, 'bulldog-frances-fluffy-');

    let h1 = row['H1 Título'] || 'Bulldog Francés Fluffy';
    let metaDesc = row['Meta Descripción'] || '';
    let historia = row['Historia Local'] || '';

    if (!isFluffyCsv) {
      h1 = h1.replace(/Maine Coon/gi, 'Bulldog Francés Fluffy').replace(/Gato/gi, 'Bulldog Fluffy');
      metaDesc = metaDesc
        .replace(/Maine Coon/gi, 'Bulldog Francés Fluffy')
        .replace(/gatos/gi, 'cachorros')
        .replace(/gigantes/gi, 'exóticos de pelo largo');
      historia = historia
        .replace(/Maine Coon/gi, 'Bulldog Francés Fluffy')
        .replace(/felino/gi, 'canino')
        .replace(/gato doméstico/gi, 'Bulldog Fluffy')
        .replace(/gato/gi, 'cachorro');
    }

    const pais = row['País'] || 'Colombia';
    const ciudad = h1.replace(/Bulldog Francés Fluffy en /gi, '').replace(/Bulldog Francês Fluffy en /gi, '').trim();
    const aeropuerto = row['Aeropuerto'] || 'Aeropuerto Local';
    const moneda = row['Moneda'] || 'USD';

    return {
      params: { slug: cleanSlug },
      props: {
        item: {
          slug: cleanSlug,
          h1,
          metaDesc,
          historia,
          pais,
          ciudad,
          aeropuerto,
          moneda,
        },
      },
    };
  });
}

const { item } = Astro.props;

const FLAG_MAP: Record<string, string> = {
  'Colombia': '🇨🇴',
  'México': '🇲🇽',
  'Costa Rica': '🇨🇷',
  'El Salvador': '🇸🇻',
  'Guatemala': '🇬🇹',
  'Honduras': '🇭🇳',
  'Nicaragua': '🇳🇮',
  'Panamá': '🇵🇦',
  'República Dominicana': '🇩🇴',
  'Argentina': '🇦🇷',
  'Bolivia': '🇧🇴',
  'Brasil': '🇧🇷',
  'Chile': '🇨🇱',
  'Ecuador': '🇪🇨',
  'Paraguay': '🇵🇾',
  'Perú': '🇵🇪',
  'Uruguay': '🇺🇾',
  'Venezuela': '🇻🇪',
  'España': '🇪🇸',
  'Estados Unidos': '🇺🇸',
  'EE. UU.': '🇺🇸',
  'EE.UU.': '🇺🇸',
  'USA': '🇺🇸'
};

// Construir tabla de precios para esta localización
const filasPrecios = fluffy.variedades.map((v) => ({
  variedad: v.nombreCorto,
  tipo: v.variantes[0]?.tipo || 'Estándar',
  registro: 'AKC / FCI',
  precioMXN: v.variantes[0]?.precioMXN || 50000,
  precioUSD: v.variantes[0]?.precioUSD || 2800,
}));

const localSchema = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: item.h1,
  description: item.metaDesc,
  category: 'Mascotas > Perros de Raza > Bulldog Francés Fluffy',
  brand: { '@type': 'Brand', name: fluffy.site.brand },
  offers: {
    '@type': 'AggregateOffer',
    priceCurrency: item.moneda,
    lowPrice: 2300,
    highPrice: 6800,
    offerCount: 5,
    availability: 'https://schema.org/InStock',
    seller: { '@id': `${fluffy.site.domain}/#criadero` },
  },
};

const authorSchema = {
  '@context': 'https://schema.org',
  '@type': 'MedicalBusiness',
  name: 'Equipo Médico Veterinario Dinastía Bulldog Fluffy',
  medicalSpecialty: 'Canine Genetics & Brachycephalic Care',
  knowsAbout: ['Gen L4/L1 Fluffy', 'Pedigree AKC/FCI', 'Nutrición Canina Exclusiva', 'Bienestar Animal Ley 1774']
};

const varietyItems = fluffy.variedades.map((v) => {
  const minUsd = Math.min(...v.variantes.map((v2) => v2.precioUSD));
  return {
    slug: v.slug,
    nombre: v.nombre,
    nombreCorto: v.nombreCorto,
    minPrecioUSD: minUsd,
    tagline: v.perfil.tagline,
  };
});
---

<Base
  title={`${item.h1} | Envíos Certificados Dinastía Bulldog Fluffy`}
  description={item.metaDesc}
  schema={[localSchema, authorSchema]}
>
  <main class="wrap">
    <Breadcrumbs
      items={[
        { nombre: 'Inicio', url: '/' },
        { nombre: 'Destinos & Envíos', url: '/destinos/' },
        { nombre: item.h1 },
      ]}
    />

    <section class="breed-hero">
      <div>
        <div style="display: flex; gap: 8px; flex-wrap: wrap; margin-bottom: 12px;">
          <span class="badge" style="background: var(--amber-soft); color: var(--amber); border-color: var(--amber);">{FLAG_MAP[item.pais] || '📍'} {item.ciudad}, {item.pais}</span>
          <span class="badge">🧬 Gen L4/L1 Lh</span>
          <span class="badge">📜 AKC / FCI</span>
        </div>

        <h1>{item.h1}</h1>

        <MovingBorderBox client:load containerClassName="w-full h-auto my-6" borderRadius="1.5rem" borderGradient="#e11d48" className="p-6 md:p-8 bg-[#121215] border border-[#27272a]">
          <p class="m-0 text-sm md:text-base leading-relaxed text-zinc-300">
            <strong class="text-rose-400">📍 Resumen de Entrega en {item.ciudad}:</strong> Entregamos cachorros <strong class="text-white">Bulldog Francés Fluffy</strong> de raza pura en <strong class="text-white">{item.ciudad}</strong> con despacho seguro hasta el <strong class="text-rose-400">{item.aeropuerto}</strong> (el costo de envío aéreo/terrestre suele rondar los $1.000 USD según la distancia). Cada cachorro se entrega con examen genético ADN de pelaje (Lh), esquema de vacunas al día, microchip ISO y contrato de salud garantizado por 2 años.
          </p>
        </MovingBorderBox>

        <p class="lead">{item.metaDesc}</p>
      </div>

      <div class="mb-10 max-w-4xl mx-auto">
        <div class="w-full h-auto rounded-2xl p-2 border border-[#27272a] bg-[#121215]">
          <div class="breed-hero-image overflow-hidden rounded-xl relative border border-[#27272a]">
            <img src="/images/fluffy-showcase-hero.jpg" alt={`Bulldog Francés Fluffy en ${item.ciudad}`} class="w-full h-80 sm:h-[420px] object-cover" />
            <div class="bg-[#121215] p-3 text-center text-xs text-rose-400 font-semibold border-t border-[#27272a]">
              ✨ Ejemplar Exótico Bulldog Francés Fluffy con Registro Pedigree AKC / FCI para envío a {item.ciudad}
            </div>
        </CardBody>
      </CardContainer>
    </section>

    {/* Criterios EEAT & Autoridad Médica Veterinarios con Card Hover Effect */}
    <EEATMedicalHoverGrid client:visible ciudad={item.ciudad} pais={item.pais} />

    <section style="margin: 36px 0;">
      <h2>🏛️ Historia Local y Aclimatación en {item.ciudad}</h2>
      <div class="answer-box" style="padding: 24px 28px;">
        <p style="font-size: 1.08rem; line-height: 1.8; margin: 0;">{item.historia}</p>
      </div>
    </section>

    <section>
      <h2>🏷️ Precios Verificados de Criadero para {item.ciudad} (2026)</h2>
      <PriceTable filas={filasPrecios} caption={`Precios de Bulldog Francés Fluffy para ${item.ciudad}`} conVariedad={true} pais={item.pais} />
    </section>

    {/* Galería de Variedades con Card Hover Effect */}
    <CityVarietyHoverGrid client:visible ciudad={item.ciudad} variedades={varietyItems} />

    {/* CTA Reserva Ciudad con Moving Border Button */}
    <div class="flex justify-center my-10">
      <MovingBorderButton
        client:visible
        borderRadius="1.25rem"
        containerClassName="h-16 w-full max-w-md"
        className="bg-slate-900/90 hover:bg-slate-900 text-purple-300 font-bold text-base px-6 py-4 border-purple-500/40 shadow-xl flex items-center justify-center gap-3"
        borderClassName="bg-[radial-gradient(#c084fc_40%,transparent_60%)]"
        as="a"
        href={`https://wa.me/573000000000?text=Hola,%20busco%20información%20sobre%20Bulldog%20Fluffy%20en%20${encodeURIComponent(item.ciudad)}`}
      >
        <span>📱 Reservar Cachorro en {item.ciudad}</span>
      </MovingBorderButton>
    </div>

    {/* Logística e Itinerario de Viaje Seguro */}
    <ShippingAccordion ciudad={item.ciudad} aeropuerto={item.aeropuerto} />

    {/* Calculadora Nutricional para la Ciudad */}
    <section style="margin: 50px 0;">
      <h2 style="text-align: center; margin-bottom: 10px;">🥗 Nutrición y Alimentación para tu Bulldog Fluffy en {item.ciudad}</h2>
      <p class="lead" style="text-align: center; margin-bottom: 24px;">
        Calcula la ración recomendada de alimento Super Premium o dieta BARF según el peso y edad de tu cachorro para mantener su pelaje sedoso en {item.ciudad}.
      </p>
      <CalculadoraComida variedad={item.ciudad} />
    </section>

    <ReviewsSection />

    <FaqSection 
      faqs={faqsData.general.map(f => ({
        q: f.q.replace(/tu ciudad/gi, item.ciudad),
        a: f.a.replace(/tu ciudad/gi, item.ciudad).replace(/aeropuerto/gi, `${item.aeropuerto}`)
      }))} 
      titulo={`Preguntas sobre envíos de cachorros a ${item.ciudad}`} 
    />

    <WhatsAppCTA contexto={`un Bulldog Francés Fluffy en ${item.ciudad}`} />

    <QuizModal />
  </main>
</Base>
