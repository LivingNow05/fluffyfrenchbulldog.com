---
import fs from 'node:fs';
import path from 'node:path';
import Base from '../layouts/Base.astro';
import WhatsAppCTA from '../components/WhatsAppCTA.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import ShippingAccordion from '../components/ShippingAccordion.astro';
import { CardContainer, CardBody, CardItem } from '../components/ui/3d-card';
import { HubCard3D } from '../components/destinos/HubCard3D';
import { HoverEffect } from '../components/ui/card-hover-effect';

function parseRow(rowStr: string): string[] {
  const values: string[] = [];
  let cur = '';
  let inQuotes = false;
  for (let i = 0; i < rowStr.length; i++) {
    const char = rowStr[i];
    const nextChar = rowStr[i + 1];
    if (char === '"') {
      if (inQuotes && nextChar === '"') {
        cur += '"';
        i++;
      } else {
        inQuotes = !inQuotes;
      }
    } else if (char === ',' && !inQuotes) {
      values.push(cur);
      cur = '';
    } else {
      cur += char;
    }
  }
  values.push(cur);
  return values;
}

function parseCSV(text: string) {
  const lines: string[] = [];
  let cur = '';
  let inQuotes = false;

  for (let i = 0; i < text.length; i++) {
    const char = text[i];
    const nextChar = text[i + 1];
    if (char === '"') {
      cur += '"';
      if (inQuotes && nextChar === '"') {
        cur += '"';
        i++;
      } else {
        inQuotes = !inQuotes;
      }
    } else if (char === '\n' && !inQuotes) {
      lines.push(cur);
      cur = '';
    } else if (char === '\r' && !inQuotes) {
      // ignore
    } else {
      cur += char;
    }
  }
  if (cur.trim()) lines.push(cur);

  const header = parseRow(lines[0]).map((h) => h.trim());
  const rows: Record<string, string>[] = [];

  for (let i = 1; i < lines.length; i++) {
    const values = parseRow(lines[i]);
    if (values.length >= 5) {
      const obj: Record<string, string> = {};
      header.forEach((h, idx) => {
        obj[h] = values[idx] ? values[idx].trim() : '';
      });
      rows.push(obj);
    }
  }
  return rows;
}

const csvPath = path.resolve(process.cwd(), 'dataset_fluffy_stories.csv');
let rawText = '';
try {
  rawText = fs.readFileSync(csvPath, 'utf-8');
} catch (e) {
  rawText = fs.readFileSync(path.resolve(process.cwd(), 'dataset_enriched_stories.csv'), 'utf-8');
}

const rawRows = parseCSV(rawText);

const locations = rawRows.map((row) => {
  const rawSlug = row['URL Final (Slug)'] || 'bulldog-frances-fluffy-bogota';
  const cleanSlug = rawSlug.replace(/^maine-coon-/, 'bulldog-frances-fluffy-');
  const h1 = row['H1 Título'] || 'Bulldog Francés Fluffy';
  const ciudad = h1.replace(/Bulldog Francés Fluffy en /gi, '').replace(/Bulldog Francês Fluffy en /gi, '').trim();
  const pais = row['País'] || 'Colombia';
  const aeropuerto = row['Aeropuerto'] || 'Aeropuerto Local';
  const moneda = row['Moneda'] || 'USD';

  return {
    slug: cleanSlug,
    url: `/${cleanSlug}/`,
    h1,
    ciudad,
    pais,
    aeropuerto,
    moneda
  };
});

// Agrupar ubicaciones por país
const groupedByCountry = locations.reduce<Record<string, typeof locations>>((acc, loc) => {
  if (!acc[loc.pais]) acc[loc.pais] = [];
  acc[loc.pais].push(loc);
  return acc;
}, {});

const countries = Object.keys(groupedByCountry).sort();

const FLAG_MAP: Record<string, string> = {
  'Colombia': '🇨🇴',
  'México': '🇲🇽',
  'Costa Rica': '🇨🇷',
  'El Salvador': '🇸🇻',
  'Guatemala': '🇬🇹',
  'Honduras': '🇭🇳',
  'Nicaragua': '🇳🇮',
  'Panamá': '🇵🇦',
  'República Dominicana': '🇩🇴',
  'Argentina': '🇦🇷',
  'Bolivia': '🇧🇴',
  'Brasil': '🇧🇷',
  'Chile': '🇨🇱',
  'Ecuador': '🇪🇨',
  'Paraguay': '🇵🇾',
  'Perú': '🇵🇪',
  'Uruguay': '🇺🇾',
  'Venezuela': '🇻🇪',
  'España': '🇪🇸',
  'Estados Unidos': '🇺🇸',
  'EE. UU.': '🇺🇸',
  'EE.UU.': '🇺🇸',
  'USA': '🇺🇸'
};

// Hubs internacionales destacados para la sección 3D Card
const HUB_TARGETS = ['bogota', 'bogotá', 'cdmx', 'ciudad de méxico', 'miami', 'madrid', 'lima', 'santiago'];
const featuredHubs = locations.filter((loc) =>
  HUB_TARGETS.some((target) => loc.ciudad.toLowerCase().includes(target))
).reduce((unique: typeof locations, loc) => {
  if (!unique.some((item) => item.ciudad === loc.ciudad)) {
    unique.push(loc);
  }
  return unique;
}, []).slice(0, 6);

const hubLocations = featuredHubs.length >= 4 ? featuredHubs : locations.slice(0, 6);
---

<Base
  title="Destinos y Cobertura de Envíos | Dinastía Bulldog Fluffy"
  description="Conoce las 100+ ciudades y aeropuertos donde entregamos personalmente nuestros cachorros Bulldog Francés Fluffy en Colombia, México, EE. UU. y el mundo."
>
  <div class="wrap">
    <Breadcrumbs items={[{ name: 'Inicio', url: '/' }, { name: 'Destinos y Cobertura' }]} />
  </div>

  <section class="hero" style="padding: 60px 0 50px; margin-top: 0;">
    <div class="wrap text-center">
      <p class="hero-kicker" style="color: #a855f7; background: rgba(147, 51, 234, 0.14); border-color: rgba(168, 85, 247, 0.35);">Entrega VIP Presencial · Niñera Aérea</p>
      <h1>Destinos & Cobertura de <em style="color: #a855f7;">Entregas por Ciudad</em></h1>
      <p class="lead" style="margin: 0 auto 28px;">
        Entregamos nuestros cachorros <strong>Bulldog Francés Fluffy</strong> con transporte climatizado presencial en más de 100 ciudades. Selecciona tu ubicación para conocer la historia local, aeropuerto y protocolo de llegada.
      </p>

      {/* Buscador interactivo instantáneo */}
      <div style="max-width: 580px; margin: 0 auto; position: relative;">
        <input
          type="text"
          id="city-search"
          placeholder="🔍 Escribe tu ciudad (ej. Bogotá, CDMX, Lima, Madrid)..."
          style="width: 100%; padding: 18px 24px; border-radius: 999px; border: 2px solid rgba(168, 85, 247, 0.4); background: rgba(18, 16, 32, 0.95); color: #fcfcfd; font-size: 1.05rem; box-shadow: 0 8px 30px rgba(0,0,0,0.5); outline: none; transition: border-color 0.2s, background 0.2s;"
        />
        <div id="search-results" style="display: none; position: absolute; top: 110%; left: 0; right: 0; background: rgba(18, 16, 32, 0.98); backdrop-filter: blur(16px); border: 1.5px solid rgba(168, 85, 247, 0.4); border-radius: 18px; max-height: 320px; overflow-y: auto; z-index: 200; box-shadow: 0 16px 40px rgba(0,0,0,0.8); text-align: left;"></div>
      </div>
    </div>
  </section>

  <main class="wrap" style="padding-top: 40px;">
    {/* Sección Hubs Internacionales Destacados con 3D Cards */}
    <section class="featured-hubs-section mb-16">
      <div class="text-center mb-8">
        <span class="inline-block px-4 py-1.5 rounded-full bg-purple-950/40 text-purple-300 border border-purple-800/40 text-xs font-extrabold uppercase tracking-widest mb-3">
          🛫 Hubs Internacionales Destacados
        </span>
        <h2 class="text-3xl sm:text-4xl font-extrabold text-white tracking-tight">
          Ciudades con Cobertura VIP Preferencial
        </h2>
        <p class="text-zinc-400 text-sm max-w-2xl mx-auto mt-2">
          Puntos estratégicos de conexión internacional con atención médica veterinaria y niñera aérea dedicada.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 max-w-6xl mx-auto px-4">
        {hubLocations.map((loc) => (
          <HubCard3D
            client:load
            ciudad={loc.ciudad}
            pais={loc.pais}
            flag={FLAG_MAP[loc.pais] || '📍'}
            aeropuerto={loc.aeropuerto}
            moneda={loc.moneda}
            url={loc.url}
          />
        ))}
      </div>
    </section>

    {/* Navegación rápida por países */}
    <div style="display: flex; gap: 12px; flex-wrap: wrap; margin-bottom: 36px; justify-content: center;">
      {countries.map((c) => (
        <a href={`#pais-${c.toLowerCase().replace(/\s+/g, '-')}`} class="btn btn--ghost" style="padding: 8px 20px; font-size: 0.9rem; border-color: rgba(168, 85, 247, 0.35); color: #fcfcfd;">
          {FLAG_MAP[c] || '📍'} {c} ({groupedByCountry[c].length})
        </a>
      ))}
    </div>

    {/* Secciones por país con HoverEffect */}
    {countries.map((country) => {
      const cityItems = groupedByCountry[country].map((loc) => ({
        title: `${loc.ciudad} ${FLAG_MAP[country] || ''}`,
        description: `✈️ Aeropuerto: ${loc.aeropuerto} · Moneda: ${loc.moneda}\nVer disponibilidad & historia local →`,
        link: loc.url
      }));

      return (
        <section id={`pais-${country.toLowerCase().replace(/\s+/g, '-')}`} style="margin-bottom: 56px;">
          <div style="display: flex; align-items: center; gap: 12px; border-bottom: 2px solid rgba(168, 85, 247, 0.4); padding-bottom: 10px; margin-bottom: 16px;">
            <h2 style="margin: 0; font-size: 1.7rem; color: #fcfcfd;">{FLAG_MAP[country] || '📍'} {country}</h2>
            <span class="badge" style="background: rgba(147, 51, 234, 0.2); color: #a855f7; border-color: rgba(168, 85, 247, 0.4);">{groupedByCountry[country].length} ciudades</span>
          </div>

          <HoverEffect client:load items={cityItems} />
        </section>
      );
    })}

    <ShippingAccordion ciudad="tu ciudad de residencia" />
    <WhatsAppCTA contexto="envíos internacionales de Bulldog Fluffy" />
  </main>

  <script id="fluffy-locations-data" type="application/json" set:html={JSON.stringify(locations)} />
  <script is:inline>
    const locationsData = JSON.parse(document.getElementById('fluffy-locations-data').textContent || '[]');
    const searchInput = document.getElementById('city-search');
    const resultsContainer = document.getElementById('search-results');

    if (searchInput && resultsContainer) {
      searchInput.addEventListener('input', (e) => {
        const query = e.target.value.toLowerCase().trim();
        if (query.length < 2) {
          resultsContainer.style.display = 'none';
          return;
        }

        const matches = locationsData.filter((l) => 
          l.ciudad.toLowerCase().includes(query) || 
          l.pais.toLowerCase().includes(query) ||
          l.aeropuerto.toLowerCase().includes(query)
        ).slice(0, 8);

        if (matches.length === 0) {
          resultsContainer.innerHTML = '<div style="padding: 16px; color: var(--ink-soft); text-align: center;">No se encontraron ciudades con ese nombre.</div>';
        } else {
          resultsContainer.innerHTML = matches.map((m) => `
            <a href="${m.url}" style="display: block; padding: 14px 20px; border-bottom: 1px solid rgba(168, 85, 247, 0.2); text-decoration: none; color: #fcfcfd; transition: background 0.2s;">
              <strong style="color: #a855f7;">${m.ciudad}</strong>, ${m.pais}
              <div style="font-size: 0.8rem; color: #a1a1aa;">✈️ ${m.aeropuerto}</div>
            </a>
          `).join('');
        }
        resultsContainer.style.display = 'block';
      });

      document.addEventListener('click', (e) => {
        if (!searchInput.contains(e.target) && !resultsContainer.contains(e.target)) {
          resultsContainer.style.display = 'none';
        }
      });
    }
  </script>
</Base>
