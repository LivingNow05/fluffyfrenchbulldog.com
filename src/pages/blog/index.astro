---
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import WhatsAppCTA from '../../components/WhatsAppCTA.astro';

interface PostFrontmatter {
  title: string;
  description: string;
  date: string;
  author: string;
  category: string;
}

const posts = await Astro.glob<PostFrontmatter>('../../data/blog/*.md');
const sortedPosts = posts.sort(
  (a, b) => new Date(b.frontmatter.date).getTime() - new Date(a.frontmatter.date).getTime()
);
---

<Base
  title="Blog & Guías sobre Bulldog Francés Fluffy | Dinastía Bulldog Fluffy"
  description="Artículos especializados sobre cuidados, nutrición, genética de colores exóticos y salud del Bulldog Francés Fluffy."
>
  <main class="wrap">
    <Breadcrumbs
      items={[
        { nombre: 'Inicio', url: '/' },
        { nombre: 'Blog & Guías' },
      ]}
    />

    <h1 style="margin-top: 24px;">Blog & Guías sobre el Bulldog Francés Fluffy</h1>
    <p class="lead">
      Aprende todo lo que necesitas saber sobre el cuidado, la alimentación, la genética del pelo largo y la crianza responsable de esta fascinante raza canina.
    </p>

    <div class="grid" style="margin: 36px 0;">
      {sortedPosts.map((post) => {
        const slug = post.file.split('/').pop()?.replace('.md', '');
        return (
          <article class="card">
            <span class="badge" style="width: fit-content;">{post.frontmatter.category}</span>
            <h3>
              <a href={`/blog/${slug}/`} style="color: inherit; text-decoration: none;">
                {post.frontmatter.title}
              </a>
            </h3>
            <p>{post.frontmatter.description}</p>
            <div style="font-size: 0.8rem; color: var(--ink-soft); margin-top: auto; padding-top: 12px;">
              <span>{post.frontmatter.date}</span> · <span>Por {post.frontmatter.author}</span>
            </div>
          </article>
        );
      })}
    </div>

    <WhatsAppCTA contexto="asesoría sobre el cuidado de un Bulldog Fluffy" />
  </main>
</Base>
