---
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import WhatsAppCTA from '../../components/WhatsAppCTA.astro';
import { BlogHoverGrid, type BlogPostItem } from '../../components/blog/BlogHoverGrid';
import { MovingBorderBox } from '../../components/colores/MovingBorderBox';

interface PostFrontmatter {
  title: string;
  description: string;
  date: string;
  author: string;
  category: string;
}

const posts = await Astro.glob<PostFrontmatter>('../../data/blog/*.md');
const sortedPosts = posts.sort(
  (a, b) => new Date(b.frontmatter.date).getTime() - new Date(a.frontmatter.date).getTime()
);

const blogItems: BlogPostItem[] = sortedPosts.map((post) => {
  const slug = post.file.split('/').pop()?.replace('.md', '') || '';
  return {
    title: post.frontmatter.title,
    description: post.frontmatter.description,
    slug,
    date: post.frontmatter.date,
    author: post.frontmatter.author,
    category: post.frontmatter.category,
  };
});
---

<Base
  title="Blog & Guías sobre Bulldog Francés Fluffy | Dinastía Bulldog Fluffy"
  description="Artículos especializados sobre cuidados, nutrición, genética de colores exóticos y salud del Bulldog Francés Fluffy."
>
  <main class="wrap">
    <Breadcrumbs
      items={[
        { nombre: 'Inicio', url: '/' },
        { nombre: 'Blog & Guías' },
      ]}
    />

    <h1 style="margin-top: 24px;">Blog & Guías sobre el Bulldog Francés Fluffy</h1>
    <p class="lead">
      Aprende todo lo que necesitas saber sobre el cuidado, la alimentación, la genética del pelo largo y la crianza responsable de esta fascinante raza canina.
    </p>

    <BlogHoverGrid client:visible posts={blogItems} />

    <div class="p-6 rounded-2xl bg-[#121215] border border-[#27272a] my-8">
      <div class="flex flex-col md:flex-row items-center justify-between gap-4 py-2">
        <div>
          <h3 class="text-xl font-bold text-white mb-1 m-0">📬 Boletín VIP & Asesoría Canina Exclusiva</h3>
          <p class="text-sm text-zinc-400 m-0 mt-1">
            ¿Buscas orientación personalizada sobre genética Fluffy o disponibilidad de próximas camadas? Escríbenos directamente a nuestro WhatsApp oficial.
          </p>
        </div>
        <a
          href="https://wa.me/573128375043?text=Hola,%20quisiera%20recibir%20asesor%C3%ADa%20y%20novedades%20del%20blog%20de%20Dinast%C3%ADa%20Bulldog%20Fluffy"
          target="_blank"
          rel="noopener noreferrer"
          class="shrink-0 px-6 py-3 bg-rose-600 hover:bg-rose-700 text-white font-bold rounded-xl transition-colors no-underline text-sm shadow-sm"
        >
          Consultar con Criadores →
        </a>
      </div>
    </div>

    <WhatsAppCTA contexto="asesoría sobre el cuidado de un Bulldog Fluffy" />
  </main>
</Base>
