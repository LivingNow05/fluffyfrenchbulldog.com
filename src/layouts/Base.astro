---
import '@fontsource-variable/space-grotesk';
import '@fontsource-variable/inter';
import '../styles/global.css';
import fluffy from '../data/fluffy.json';
import QuizModal from '../components/QuizModal.astro';
import WhatsAppIcon from '../components/WhatsAppIcon.astro';
import BulldogIcon from '../components/BulldogIcon.astro';

export interface Props {
  title: string;
  description: string;
  ogImage?: string;
  /** JSON-LD adicional de la página (Product, FAQPage, etc.) */
  schema?: object[];
  /** Nombre de la variedad para dar contexto al modal de WhatsApp */
  variedad?: string;
}

const { title, description, ogImage = '/images/fluffy_showcase_hero.jpg', schema = [], variedad } = Astro.props;
const { site } = fluffy;

// Catálogo compacto para el modal-quiz
const catalogo = fluffy.variedades.map((v) => ({
  nombre: v.nombre,
  nombreCorto: v.nombreCorto || v.nombre,
  slug: v.slug,
  url: `/colores/${v.slug}/`,
  desde: Math.min(...v.variantes.map((v2) => v2.precioUSD)),
  desdeUSD: Math.min(...v.variantes.map((v2) => v2.precioUSD)),
  perfil: v.perfil,
}));
const canonical = new URL(Astro.url.pathname, Astro.site || 'https://fluffyfrenchbulldog.com');

const localBusiness = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  '@id': `${site.domain}/#criadero`,
  name: site.brand,
  description: site.descripcion,
  url: site.domain,
  telephone: site.whatsapp,
  address: { '@type': 'PostalAddress', addressCountry: 'CO' },
  memberOf: site.afiliaciones.map((a) => ({ '@type': 'Organization', name: a })),
};

const allSchema = [localBusiness, ...schema];
---

<html lang="es-CO">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="es_CO" />
    <meta property="og:site_name" content={site.brand} />
    <meta property="og:image" content={new URL(ogImage, canonical).href} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={new URL(ogImage, canonical).href} />
    <script is:inline>
      const getTheme = () => {
        if (typeof localStorage !== 'undefined' && localStorage.getItem('theme')) {
          return localStorage.getItem('theme');
        }
        return 'dark';
      };
      if (getTheme() === 'light') {
        document.documentElement.classList.add('light-theme');
      } else {
        document.documentElement.classList.remove('light-theme');
      }
    </script>
    {allSchema.map((s) => (
      <script type="application/ld+json" set:html={JSON.stringify(s)} />
    ))}
    <script is:inline define:vars={{ site, catalogo, variedad }}>
      window.FLUFFY_WA = site.whatsapp;
      window.FLUFFY_BRAND = site.brand;
      window.FLUFFY_CATALOGO = catalogo;
      window.FLUFFY_VARIEDAD = variedad || null;
    </script>
  </head>
  <body>
    <header class="site-header">
      <div class="wrap">
        <a class="logo" href="/" aria-label="Dinastía Bulldog Fluffy — Inicio">
          <svg width="28" height="28" viewBox="0 0 512 512" fill="none" class="logo-icon-svg">
            <rect width="512" height="512" rx="128" fill="#121316"/>
            <g stroke="#e8a63d" stroke-width="20" stroke-linecap="round" stroke-linejoin="round">
              <path d="M 215 168 C 190 120 152 78 122 72 C 98 67 76 86 92 108 Q 70 120 90 132 Q 74 145 100 156 Q 88 170 128 180 C 138 185 146 192 150 200" />
              <path d="M 195 154 C 172 122 144 94 122 86" stroke-width="14" opacity="0.85" />
              <path d="M 297 168 C 322 120 360 78 390 72 C 414 67 436 86 420 108 Q 442 120 422 132 Q 438 145 412 156 Q 424 170 384 180 C 374 185 366 192 362 200" />
              <path d="M 317 154 C 340 122 368 94 390 86" stroke-width="14" opacity="0.85" />
              <path d="M 215 168 Q 256 160 297 168" />
              <path d="M 150 200 C 126 225 114 248 128 265 Q 106 278 130 292 Q 118 306 146 320 C 172 362 210 380 256 380 C 302 380 340 362 366 320 Q 394 306 382 292 Q 406 278 384 265 C 398 248 386 225 362 200" />
              <path d="M 215 190 Q 256 180 297 190" stroke-width="14" opacity="0.85" />
              <circle cx="182" cy="226" r="20" fill="#e8a63d" stroke="none" />
              <circle cx="330" cy="226" r="20" fill="#e8a63d" stroke="none" />
              <path d="M 256 272 C 220 252 174 262 174 296 C 174 332 220 342 256 314 C 292 342 338 332 338 296 C 338 262 292 252 256 272 Z" />
              <path d="M 226 240 C 235 232 277 232 286 240 C 294 258 276 272 256 272 C 236 272 218 258 226 240 Z" fill="#e8a63d" stroke="none" />
              <path d="M 256 272 L 256 298" stroke-width="16" />
              <path d="M 232 306 Q 256 320 280 306" stroke-width="16" />
            </g>
          </svg>
          <span class="logo-text">Dinastía Bulldog <span>Fluffy</span></span>
        </a>
        <nav class="site-nav" aria-label="Navegación principal">
          <a href="/precios-bulldog-fluffy/">Precios</a>
          <a href="/#variedades">Variedades</a>
          <div class="nav-item-dropdown">
            <a href="/destinos/" class="dropdown-trigger">
              Ciudades <span class="drop-arrow">▾</span>
            </a>
            <div class="dropdown-menu megamenu-cities">
              <div class="megamenu-grid">
                <div class="megamenu-col">
                  <span class="col-title">🇨🇴 Colombia</span>
                  <a href="/bulldog-frances-fluffy-bogota/">Bogotá</a>
                  <a href="/bulldog-frances-fluffy-medellin/">Medellín</a>
                  <a href="/bulldog-frances-fluffy-cali/">Cali</a>
                  <a href="/bulldog-frances-fluffy-barranquilla/">Barranquilla</a>
                </div>
                <div class="megamenu-col">
                  <span class="col-title">🇲🇽 México</span>
                  <a href="/bulldog-frances-fluffy-cdmx/">CDMX</a>
                  <a href="/bulldog-frances-fluffy-guadalajara/">Guadalajara</a>
                  <a href="/bulldog-frances-fluffy-monterrey/">Monterrey</a>
                  <a href="/bulldog-frances-fluffy-queretaro/">Querétaro</a>
                </div>
                <div class="megamenu-col">
                  <span class="col-title">🇵🇪 Perú & 🇨🇱 Chile</span>
                  <a href="/bulldog-frances-fluffy-lima/">Lima</a>
                  <a href="/bulldog-frances-fluffy-arequipa/">Arequipa</a>
                  <a href="/bulldog-frances-fluffy-santiago/">Santiago</a>
                  <a href="/bulldog-frances-fluffy-valparaiso/">Valparaíso</a>
                </div>
                <div class="megamenu-col col-cta">
                  <span class="col-title">✈️ Cobertura Global</span>
                  <p>Envíos internacionales con Travel Nanny a 100+ destinos.</p>
                  <a href="/destinos/" class="btn-all-cities">Ver las 100+ Ciudades →</a>
                </div>
              </div>
            </div>
          </div>
          <a href="/blog/">Blog</a>
          <a href="/sobre-nosotros/">Criadero</a>
          <a class="nav-cta" href={`https://wa.me/${site.whatsapp.replace(/[^\d]/g, '')}`} target="_blank" rel="noopener" aria-label="WhatsApp">
            <WhatsAppIcon size={16} class="cta-icon" />
            <span class="cta-text">WhatsApp</span>
          </a>
        </nav>
        <div class="header-controls">
          <button id="theme-toggle" class="theme-toggle-btn" aria-label="Cambiar tema visual" type="button">
            <svg class="sun-icon" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="4"></circle>
              <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"></path>
            </svg>
            <svg class="moon-icon" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
            </svg>
          </button>
          <button id="menu-toggle" class="menu-toggle-btn" aria-label="Abrir menú de navegación" aria-expanded="false" type="button">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <line x1="3" y1="6" x2="21" y2="6" class="line-top"></line>
              <line x1="3" y1="12" x2="21" y2="12" class="line-middle"></line>
              <line x1="3" y1="18" x2="21" y2="18" class="line-bottom"></line>
            </svg>
          </button>
        </div>
      </div>
    </header>

    <slot />

    <footer class="site-footer">
      <div class="wrap cols">
        <div>
          <h4>{site.brand}</h4>
          <p>
            Criadero especializado en Bulldog Francés Fluffy con linaje exótico.<br />
            Registros {site.afiliaciones.join(' · ')}<br />
            Precios y garantías verificados: {site.preciosVerificados}
          </p>
        </div>
        <div>
          <h4>Variedades Exóticas</h4>
          <ul>
            {fluffy.variedades.map((v) => (
              <li><a href={`/colores/${v.slug}/`}>{v.nombreCorto}</a></li>
            ))}
          </ul>
        </div>
        <div>
          <h4>Ciudades & Cobertura</h4>
          <ul>
            <li><a href="/destinos/">📍 Ver las 100+ Ciudades</a></li>
            <li><a href="/bulldog-frances-fluffy-bogota/">Bulldog Fluffy en Bogotá</a></li>
            <li><a href="/bulldog-frances-fluffy-medellin/">Bulldog Fluffy en Medellín</a></li>
            <li><a href="/bulldog-frances-fluffy-cdmx/">Bulldog Fluffy en CDMX</a></li>
            <li><a href="/bulldog-frances-fluffy-buenos-aires/">Bulldog Fluffy en Buenos Aires</a></li>
          </ul>
        </div>
        <div>
          <h4>Información & Legal</h4>
          <ul>
            <li><a href="/precios-bulldog-fluffy/">Precios y Genética 2026</a></li>
            <li><a href="/blog/">Blog y Cuidados Fluffy</a></li>
            <li><a href="/sobre-nosotros/">Garantías y Metodología</a></li>
          </ul>
        </div>
        </div>
      <div class="wrap fine">
        <p>
          © {new Date().getFullYear()} {site.brand}. Promovemos la crianza ética y la tenencia responsable de mascotas (Cumplimiento Ley 1774 de 2016 y normativas internacionales). Todos los derechos reservados.
        </p>
      </div>
    </footer>

    <script
      is:inline
      set:html={`window.FLUFFY_WA=${JSON.stringify(site.whatsapp)};window.FLUFFY_BRAND=${JSON.stringify(
        site.brand
      )};window.FLUFFY_CATALOGO=${JSON.stringify(catalogo)};window.GATOS_CATALOGO=window.FLUFFY_CATALOGO;window.GATOS_WA=window.FLUFFY_WA;window.GATOS_BRAND=window.FLUFFY_BRAND;${
        variedad ? `window.FLUFFY_VARIEDAD=${JSON.stringify(variedad)};window.GATOS_RAZA=${JSON.stringify(variedad)};` : ''
      }`}
    />
    <QuizModal />
    <script>
      // Tema visual
      const toggle = document.getElementById('theme-toggle');
      toggle?.addEventListener('click', () => {
        const isLight = document.documentElement.classList.toggle('light-theme');
        localStorage.setItem('theme', isLight ? 'light' : 'dark');
      });

      // Menú móvil responsivo
      const menuToggle = document.getElementById('menu-toggle');
      const siteNav = document.querySelector('.site-nav');
      const body = document.body;

      if (menuToggle && siteNav) {
        const toggleMenu = () => {
          const isOpen = menuToggle.classList.toggle('active');
          siteNav.classList.toggle('active');
          body.classList.toggle('nav-active');
          menuToggle.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
        };

        const closeMenu = () => {
          menuToggle.classList.remove('active');
          siteNav.classList.remove('active');
          body.classList.remove('nav-active');
          menuToggle.setAttribute('aria-expanded', 'false');
        };

        menuToggle.addEventListener('click', toggleMenu);
        siteNav.querySelectorAll('a').forEach((link) => link.addEventListener('click', closeMenu));
        document.addEventListener('keydown', (e) => {
          if (e.key === 'Escape' && siteNav.classList.contains('active')) closeMenu();
        });
      }

      // Animación de aparición al hacer scroll (Reveal)
      const observerOptions = { threshold: 0.08 };
      const observer = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-visible');
          }
        });
      }, observerOptions);
      document.querySelectorAll('.reveal, .cta-box').forEach((el) => observer.observe(el));
    </script>
    <a class="whatsapp-float" href={`https://wa.me/${site.whatsapp.replace(/[^\d]/g, '')}`} target="_blank" rel="noopener" aria-label="Hablar por WhatsApp">
      <span class="whatsapp-float-tooltip">💬 ¿Hablamos por WhatsApp?</span>
      <WhatsAppIcon size={28} />
    </a>

    <style is:global>
      .header-controls { display: flex; align-items: center; gap: 16px; }
      .menu-toggle-btn {
        display: none; background: none; border: none; color: var(--moon-soft); cursor: pointer; padding: 8px; align-items: center; justify-content: center; z-index: 1100; transition: color 0.3s var(--ease-out), transform 0.2s var(--ease-out); border-radius: 50%;
      }
      .menu-toggle-btn:hover { color: var(--moon); transform: scale(1.05); }
      .menu-toggle-btn svg line { transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.2s ease, stroke 0.3s ease; transform-origin: center; }
      .menu-toggle-btn.active .line-middle { opacity: 0; transform: scaleX(0); }
      .menu-toggle-btn.active .line-top { transform: translateY(6px) rotate(45deg); stroke: var(--amber-bright); }
      .menu-toggle-btn.active .line-bottom { transform: translateY(-6px) rotate(-45deg); stroke: var(--amber-bright); }
      body.nav-active { overflow: hidden; height: 100vh; }

      @media (max-width: 1024px) {
        .header-controls { gap: 10px; }
        .menu-toggle-btn { display: inline-flex; }
        .nav-cta .cta-icon { display: inline-block; }
        .site-nav {
          display: flex !important; flex-direction: column !important; align-items: center !important; justify-content: center !important; gap: 28px !important; position: fixed !important; top: 0 !important; left: 0 !important; width: 100% !important; height: 100vh !important; background: rgba(12, 12, 14, 0.97) !important; backdrop-filter: blur(24px) saturate(1.4) !important; -webkit-backdrop-filter: blur(24px) saturate(1.4) !important; z-index: 1050 !important; opacity: 0; pointer-events: none; transform: translateY(-10px); transition: opacity 0.4s cubic-bezier(0.16, 1, 0.3, 1), transform 0.4s cubic-bezier(0.16, 1, 0.3, 1) !important;
        }
        :root.light-theme .site-nav {
          background: rgba(250, 249, 246, 0.97) !important;
        }
        .site-nav.active { opacity: 1 !important; pointer-events: auto !important; transform: translateY(0) !important; }
        .site-nav a:not(.nav-cta) {
          font-family: var(--font-display) !important; font-size: 1.8rem !important; font-weight: 600 !important; color: var(--moon) !important; text-decoration: none !important; letter-spacing: -0.02em !important; opacity: 0; transform: translateY(15px);
        }
        .site-nav.active a:not(.nav-cta) { opacity: 1 !important; transform: translateY(0) !important; transition: opacity 0.5s cubic-bezier(0.16, 1, 0.3, 1), transform 0.5s cubic-bezier(0.16, 1, 0.3, 1) !important; }
        .site-nav .nav-cta {
          display: inline-flex !important; align-items: center !important; justify-content: center !important; gap: 10px !important; margin-top: 16px !important; background: var(--whatsapp) !important; color: #ffffff !important; text-decoration: none !important; font-family: var(--font-display) !important; font-weight: 750 !important; font-size: 1.1rem !important; padding: 14px 36px !important; border-radius: 999px !important; width: calc(100% - 40px) !important; max-width: 280px !important; box-shadow: 0 10px 25px rgba(31, 179, 85, 0.4) !important; opacity: 0; transform: translateY(15px);
        }
        .site-nav.active .nav-cta { opacity: 1 !important; transform: translateY(0) !important; }
      }
    </style>

  </body>
</html>
