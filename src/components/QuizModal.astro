---
// Componente Quiz Modal de Calificación de Leads — Dinastía Bulldog Fluffy
// Modal Quiz Interactivo de WhatsApp para consulta de disponibilidad
import WhatsAppIcon from './WhatsAppIcon.astro';
---

<div id="qm-overlay" class="qm-overlay" style="display:none;" aria-hidden="true" role="dialog" aria-modal="true">
  <div id="qm-backdrop" class="qm-backdrop"></div>
  <div id="qm-card" class="qm-card">
    <button type="button" id="qm-close" class="qm-close" aria-label="Cerrar modal">&times;</button>
    
    <div class="qm-head">
      <span id="qm-badge" class="qm-badge">ENCUENTRA TU BULLDOG FLUFFY IDEAL</span>
      <h3 id="qm-title" class="qm-title">Cuéntanos un poco sobre ti</h3>
      <p id="qm-subtitle" class="qm-subtitle">Te recomendamos la variedad de Bulldog Fluffy perfecta según tu perfil, estilo de vida y presupuesto.</p>
    </div>

    <div id="qm-progress" class="qm-progress">
      <!-- Pasos inyectados dinámicamente por quiz-modal.js -->
    </div>

    <div id="qm-steps" class="qm-steps">
      <!-- Pasos inyectados dinámicamente por quiz-modal.js -->
    </div>
  </div>
</div>

<script src="/scripts/quiz-modal.js" is:inline></script>

<style is:global>
  .qm-overlay {
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    z-index: 99999;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 16px;
    box-sizing: border-box;
  }

  .qm-backdrop {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(8, 8, 12, 0.9);
    backdrop-filter: blur(24px) saturate(1.5);
    -webkit-backdrop-filter: blur(24px) saturate(1.5);
  }

  :root.light-theme .qm-backdrop {
    background: rgba(240, 240, 248, 0.88);
  }

  .qm-card {
    position: relative;
    z-index: 10;
    width: 100%;
    max-width: 560px;
    max-height: 90vh;
    overflow-y: auto;
    background: rgba(13, 9, 26, 0.95);
    backdrop-filter: blur(24px);
    -webkit-backdrop-filter: blur(24px);
    border: 1px solid rgba(168, 85, 247, 0.35);
    border-radius: 28px;
    padding: 32px 28px;
    box-shadow: 0 25px 70px rgba(0, 0, 0, 0.9), 0 0 50px rgba(168, 85, 247, 0.2);
    box-sizing: border-box;
    color: #f4f4f5;
    transition: border-color 0.3s ease, box-shadow 0.3s ease;
  }

  :root.light-theme .qm-card {
    background: rgba(255, 255, 255, 0.96);
    border-color: rgba(124, 58, 237, 0.3);
    color: #18181b;
    box-shadow: 0 25px 60px -15px rgba(124, 58, 237, 0.2);
  }

  .qm-close {
    position: absolute;
    top: 18px;
    right: 18px;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.1);
    color: #a1a1aa;
    font-size: 24px;
    cursor: pointer;
    line-height: 1;
    width: 36px;
    height: 36px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    transition: all 0.2s ease;
  }

  .qm-close:hover {
    color: #ffffff;
    background: rgba(168, 85, 247, 0.25);
    border-color: rgba(168, 85, 247, 0.4);
    transform: rotate(90deg);
  }

  :root.light-theme .qm-close:hover {
    color: #18181b;
    background: rgba(124, 58, 237, 0.1);
    border-color: rgba(124, 58, 237, 0.3);
  }

  .qm-head {
    text-align: center;
    margin-bottom: 22px;
  }

  .qm-badge {
    display: inline-block;
    padding: 5px 14px;
    border-radius: 999px;
    background: linear-gradient(135deg, rgba(168, 85, 247, 0.15), rgba(245, 158, 11, 0.15));
    border: 1px solid rgba(168, 85, 247, 0.4);
    color: #c084fc;
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    margin-bottom: 12px;
  }

  :root.light-theme .qm-badge {
    background: rgba(124, 58, 237, 0.1);
    border-color: rgba(124, 58, 237, 0.3);
    color: #7c3aed;
  }

  .qm-title {
    font-family: var(--font-display, sans-serif);
    font-size: 1.5rem;
    font-weight: 800;
    color: inherit;
    margin: 0 0 6px 0;
    line-height: 1.25;
    background: linear-gradient(135deg, #ffffff 0%, #e9d5ff 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  :root.light-theme .qm-title {
    background: linear-gradient(135deg, #1e1035 0%, #5b21b6 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .qm-subtitle {
    font-size: 0.92rem;
    color: #a1a1aa;
    margin: 0;
    line-height: 1.5;
  }

  :root.light-theme .qm-subtitle {
    color: #52525b;
  }

  .qm-progress {
    display: flex;
    gap: 8px;
    margin-bottom: 24px;
  }

  .qm-progress-seg {
    flex: 1;
    height: 5px;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.08);
    transition: background 0.35s ease, box-shadow 0.35s ease;
  }

  :root.light-theme .qm-progress-seg {
    background: rgba(0, 0, 0, 0.08);
  }

  .qm-progress-seg.is-active {
    background: linear-gradient(90deg, #a855f7 0%, #f59e0b 100%);
    box-shadow: 0 0 12px rgba(168, 85, 247, 0.6);
  }

  :root.light-theme .qm-progress-seg.is-active {
    background: linear-gradient(90deg, #7c3aed 0%, #d97706 100%);
    box-shadow: 0 0 10px rgba(124, 58, 237, 0.4);
  }

  .qm-steps {
    transition: opacity 0.25s ease;
  }

  .qm-question {
    font-size: 1.15rem;
    font-weight: 700;
    color: inherit;
    margin: 0 0 16px 0;
  }

  .qm-hint {
    font-size: 0.86rem;
    color: #a1a1aa;
    margin: -8px 0 16px 0;
  }

  :root.light-theme .qm-hint {
    color: #71717a;
  }

  .qm-options {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .qm-options--grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 12px;
  }

  @media (max-width: 480px) {
    .qm-options--grid {
      grid-template-columns: 1fr;
    }
  }

  .qm-opt {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    text-align: left;
    padding: 16px 18px;
    border-radius: 16px;
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(168, 85, 247, 0.2);
    color: inherit;
    cursor: pointer;
    transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
  }

  :root.light-theme .qm-opt {
    background: #f8fafc;
    border-color: rgba(124, 58, 237, 0.15);
  }

  .qm-opt:hover {
    background: rgba(168, 85, 247, 0.12);
    border-color: rgba(192, 132, 252, 0.5);
    transform: translateY(-2px);
    box-shadow: 0 8px 25px rgba(168, 85, 247, 0.2);
  }

  :root.light-theme .qm-opt:hover {
    background: rgba(124, 58, 237, 0.08);
    border-color: rgba(124, 58, 237, 0.4);
    box-shadow: 0 8px 20px rgba(124, 58, 237, 0.12);
  }

  .qm-opt-emoji {
    font-size: 1.6rem;
    margin-bottom: 6px;
  }

  .qm-opt-label {
    font-size: 0.98rem;
    font-weight: 700;
    color: inherit;
  }

  .qm-opt-sub {
    font-size: 0.8rem;
    color: #a1a1aa;
    margin-top: 3px;
  }

  :root.light-theme .qm-opt-sub {
    color: #71717a;
  }

  .qm-input {
    width: 100%;
    padding: 16px 18px;
    border-radius: 16px;
    border: 1px solid rgba(168, 85, 247, 0.35);
    background: rgba(0, 0, 0, 0.4);
    color: inherit;
    font-size: 1rem;
    margin-bottom: 16px;
    box-sizing: border-box;
    outline: none;
    transition: border-color 0.25s, box-shadow 0.25s;
  }

  :root.light-theme .qm-input {
    background: #f8fafc;
    border-color: #cbd5e1;
  }

  .qm-input:focus {
    border-color: #c084fc;
    box-shadow: 0 0 16px rgba(192, 132, 252, 0.4);
  }

  :root.light-theme .qm-input:focus {
    border-color: #7c3aed;
    box-shadow: 0 0 14px rgba(124, 58, 237, 0.3);
  }

  .qm-next {
    width: 100%;
    padding: 16px 22px;
    border-radius: 16px;
    background: linear-gradient(135deg, #a855f7 0%, #7c3aed 100%);
    color: #ffffff;
    font-weight: 800;
    font-size: 1rem;
    border: none;
    cursor: pointer;
    transition: transform 0.2s, box-shadow 0.2s;
    box-shadow: 0 6px 20px rgba(168, 85, 247, 0.4);
  }

  .qm-next:hover {
    transform: translateY(-2px);
    box-shadow: 0 10px 28px rgba(168, 85, 247, 0.55);
  }

  .qm-next--wa {
    background: linear-gradient(135deg, #22c55e 0%, #15803d 100%);
    color: #ffffff;
    margin-top: 14px;
    box-shadow: 0 6px 20px rgba(34, 197, 94, 0.4);
  }

  .qm-next--wa:hover {
    box-shadow: 0 10px 28px rgba(34, 197, 94, 0.55);
  }

  .qm-result {
    display: flex;
    flex-direction: column;
    gap: 12px;
    margin-bottom: 16px;
  }

  .qm-rec {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 16px 18px;
    border-radius: 18px;
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(168, 85, 247, 0.2);
    text-align: left;
    cursor: pointer;
    transition: all 0.25s ease;
    width: 100%;
    box-sizing: border-box;
  }

  :root.light-theme .qm-rec {
    background: #f8fafc;
    border-color: #e2e8f0;
  }

  .qm-rec.is-selected {
    background: rgba(168, 85, 247, 0.15);
    border-color: #c084fc;
    box-shadow: 0 0 20px rgba(192, 132, 252, 0.3);
  }

  :root.light-theme .qm-rec.is-selected {
    background: rgba(124, 58, 237, 0.12);
    border-color: #7c3aed;
    box-shadow: 0 0 16px rgba(124, 58, 237, 0.2);
  }

  .qm-rec-emoji {
    font-size: 2rem;
    flex-shrink: 0;
  }

  .qm-rec-info {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 3px;
  }

  .qm-rec-name {
    font-weight: 800;
    font-size: 1.02rem;
    color: inherit;
    display: flex;
    align-items: center;
    gap: 8px;
    flex-wrap: wrap;
  }

  .qm-rec-badge {
    font-size: 0.68rem;
    padding: 3px 8px;
    border-radius: 6px;
    background: linear-gradient(135deg, #a855f7 0%, #f59e0b 100%);
    color: #ffffff;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  :root.light-theme .qm-rec-badge {
    background: linear-gradient(135deg, #7c3aed 0%, #d97706 100%);
    color: #ffffff;
  }

  .qm-rec-tag {
    font-size: 0.8rem;
    color: #a1a1aa;
  }

  :root.light-theme .qm-rec-tag {
    color: #71717a;
  }

  .qm-rec-price {
    text-align: right;
    font-size: 0.75rem;
    color: #a1a1aa;
    flex-shrink: 0;
    line-height: 1.3;
  }

  .qm-rec-price strong {
    font-size: 1rem;
    color: #c084fc;
    display: block;
    margin-top: 2px;
  }

  :root.light-theme .qm-rec-price strong {
    color: #7c3aed;
  }

  .qm-rec-price small {
    font-size: 0.75rem;
    color: #a1a1aa;
  }

  :root.light-theme .qm-rec-price small {
    color: #71717a;
  }

  .qm-link {
    display: block;
    text-align: center;
    font-size: 0.88rem;
    color: #c084fc;
    text-decoration: none;
    margin-top: 12px;
    transition: opacity 0.2s;
    font-weight: 600;
  }

  :root.light-theme .qm-link {
    color: #7c3aed;
  }

  .qm-link:hover {
    text-decoration: underline;
    opacity: 0.9;
  }
</style>
