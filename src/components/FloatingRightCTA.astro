---
import WhatsAppIcon from './WhatsAppIcon.astro';
import fluffy from '../data/fluffy.json';

const { site } = fluffy;
const numero = site.whatsapp.replace(/[^\d]/g, '');
---

<div class="floating-cta-right-bar" id="floating-cta-bar">
  <a
    href={`https://wa.me/${numero}?text=${encodeURIComponent('Hola Dinastía Bulldog Fluffy 🐾 Quisiera cotizar disponibilidad inmediata de un cachorro.')}`}
    target="_blank"
    rel="noopener"
    class="fcta-btn fcta-btn--wa"
    aria-label="Contactar por WhatsApp"
    title="WhatsApp Directo (Respuesta < 5 min)"
  >
    <WhatsAppIcon size={22} class="fcta-icon" />
    <span class="fcta-label">WhatsApp</span>
    <span class="fcta-badge">Express</span>
  </a>

  <button
    type="button"
    class="fcta-btn fcta-btn--quiz"
    onclick="if(window.QuizModal){window.QuizModal.open();}"
    aria-label="Abrir Cotizador Inteligente"
    title="Cotizador & Match IA"
  >
    <span class="fcta-emoji">🧬</span>
    <span class="fcta-label">Cotizador IA</span>
  </button>

  <a
    href="/destinos/"
    class="fcta-btn fcta-btn--geo"
    aria-label="Ver Ciudades & Envíos"
    title="Envíos a 100+ Ciudades"
  >
    <span class="fcta-emoji">📍</span>
    <span class="fcta-label">Envíos</span>
  </a>
</div>

<style>
  .floating-cta-right-bar {
    position: fixed;
    right: 18px;
    top: 50%;
    transform: translateY(-50%);
    z-index: 140;
    display: flex;
    flex-direction: column;
    gap: 10px;
    pointer-events: auto;
  }

  .fcta-btn {
    position: relative;
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 10px 14px;
    border-radius: 999px;
    font-size: 0.82rem;
    font-weight: 750;
    text-decoration: none;
    cursor: pointer;
    border: 1px solid rgba(232, 166, 61, 0.3);
    background: rgba(18, 18, 22, 0.88);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    color: #fcfbfa;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.4);
    transition: all 0.25s cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  :root.light-theme .fcta-btn {
    background: rgba(255, 255, 255, 0.92);
    border-color: rgba(217, 119, 6, 0.25);
    color: #0f172a;
    box-shadow: 0 8px 24px rgba(15, 23, 42, 0.12);
  }

  .fcta-btn:hover {
    transform: translateX(-4px) scale(1.04);
    border-color: var(--amber-bright);
    box-shadow: 0 10px 28px rgba(232, 166, 61, 0.35);
  }

  .fcta-btn--wa {
    background: linear-gradient(135deg, #1fb355, #128c46);
    color: #ffffff !important;
    border-color: rgba(255, 255, 255, 0.2);
  }
  .fcta-btn--wa:hover {
    background: linear-gradient(135deg, #23c75f, #159f50);
    box-shadow: 0 10px 28px rgba(31, 179, 85, 0.45);
  }

  .fcta-btn--quiz {
    background: rgba(232, 166, 61, 0.14);
    border-color: rgba(232, 166, 61, 0.4);
    color: var(--amber-bright);
  }
  :root.light-theme .fcta-btn--quiz {
    background: rgba(217, 119, 6, 0.1);
    color: #b45309;
  }

  .fcta-emoji {
    font-size: 1.1rem;
    line-height: 1;
  }

  .fcta-label {
    white-space: nowrap;
  }

  .fcta-badge {
    font-size: 0.62rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    background: rgba(255, 255, 255, 0.25);
    color: #ffffff;
    padding: 2px 6px;
    border-radius: 999px;
    margin-left: 2px;
  }

  @media (max-width: 860px) {
    .floating-cta-right-bar {
      right: 12px;
      top: auto;
      bottom: 84px;
      transform: none;
      gap: 8px;
    }
    .fcta-label,
    .fcta-badge {
      display: none;
    }
    .fcta-btn {
      padding: 10px;
      border-radius: 50%;
      width: 44px;
      height: 44px;
      justify-content: center;
    }
  }
</style>
