---
import fluffy from '../data/fluffy.json';

export interface Props {
  filas: { variedad?: string; tipo: string; registro: string; precioMXN?: number; precioUSD: number }[];
  caption: string;
  conVariedad?: boolean;
  pais?: string;
}

const { filas = [], caption = 'Tabla de Precios Oficial', conVariedad = false } = Astro.props;

const mxn = (n?: number) => n ? `$${n.toLocaleString('es-MX')} MXN` : 'N/A';
const usd = (n: number) => `$${n.toLocaleString('en-US')} USD`;
---

<span class="updated-tag">✓ Precios verificados: {fluffy.site.preciosVerificados} (Tarifas Internacionales USD)</span>
<div class="price-table-scroll">
  <table class="price-table">
    <caption class="sr-only" style="display:none;">{caption}</caption>
    <thead>
      <tr>
        {conVariedad && <th scope="col">Variedad / Color</th>}
        <th scope="col">Tipo de Ejemplar</th>
        <th scope="col">Registro / Pedigree</th>
        <th scope="col" class="highlighted-header">Precio Internacional (USD)</th>
      </tr>
    </thead>
    <tbody>
      {filas.map((f) => (
        <tr>
          {conVariedad && <td><strong>{f.variedad}</strong></td>}
          <td>{f.tipo}</td>
          <td>{f.registro}</td>
          <td class="num">{usd(f.precioUSD)}</td>
        </tr>
      ))}
    </tbody>
  </table>
</div>
<p class="price-note">
  * Precios de nuestros ejemplares sujetos a disponibilidad de camadas. Incluyen esquema de vacunación completo, desparasitación al día, microchip ISO, prueba de ADN genético y contrato con garantía de salud por 2 años.
</p>

<div class="travel-nanny-notice">
  <span class="nanny-icon">✈️</span>
  <div class="nanny-text">
    <strong>Nota de Viaje & Logística de Envío Internacional:</strong>
    <span>El servicio de entrega en cabina de pasajeros con Travel Nanny dedicada (niñera aérea) ronda los <strong>$1,000 USD</strong> y se cotiza de forma personalizada según el aeropuerto de tu ciudad.</span>
  </div>
</div>

<style>
  .travel-nanny-notice {
    margin-top: 16px;
    background: rgba(139, 92, 246, 0.08);
    border: 1px dashed rgba(139, 92, 246, 0.35);
    border-radius: 14px;
    padding: 14px 18px;
    display: flex;
    align-items: center;
    gap: 14px;
  }
  :root.light-theme .travel-nanny-notice {
    background: rgba(124, 58, 237, 0.06);
    border-color: rgba(124, 58, 237, 0.3);
  }
  .nanny-icon {
    font-size: 1.6rem;
  }
  .nanny-text {
    font-size: 0.88rem;
    line-height: 1.45;
    color: var(--ink-soft);
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .nanny-text strong {
    color: var(--amber-bright);
    font-weight: 750;
  }
  :root.light-theme .nanny-text strong {
    color: #6d28d9;
  }
</style>
