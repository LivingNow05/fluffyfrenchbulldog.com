---
export interface Props {
  className?: string;
}

const { className = 'bulldog-hero-svg' } = Astro.props;
---

<div class={`bulldog-animated-container ${className}`}>
  <div class="logo-image-floating-wrapper">
    <!-- Foto PNG Base del Bulldog (Sin recuadro, transparente) -->
    <img 
      src="/images/fluffy_logo.png" 
      alt="Dinastía Bulldog Fluffy Emblem" 
      class="bulldog-gold-emblem-img"
      loading="eager"
      width="340"
      height="340"
    />
    
    <!-- Capa de Ojos Interactivos Seguidora de Cursor sobre la Foto -->
    <div class="eye-tracker-overlay">
      <div class="photo-eye-socket eye-socket-left">
        <div class="photo-pupil js-photo-pupil" id="photo-pupil-l">
          <span class="pupil-dot"></span>
          <span class="pupil-shine"></span>
        </div>
      </div>
      <div class="photo-eye-socket eye-socket-right">
        <div class="photo-pupil js-photo-pupil" id="photo-pupil-r">
          <span class="pupil-dot"></span>
          <span class="pupil-shine"></span>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  function setupPhotoEyeTracking() {
    const pupils = document.querySelectorAll('.js-photo-pupil');
    if (!pupils.length) return;

    let mouseX = window.innerWidth / 2;
    let mouseY = window.innerHeight / 2;
    let ticking = false;

    function updatePhotoPupils() {
      pupils.forEach((pupil) => {
        const rect = pupil.getBoundingClientRect();
        const eyeCenterX = rect.left + rect.width / 2;
        const eyeCenterY = rect.top + rect.height / 2;

        const dx = mouseX - eyeCenterX;
        const dy = mouseY - eyeCenterY;
        const dist = Math.hypot(dx, dy);

        // Máximo desplazamiento permitido dentro del ojo (7px)
        const maxOffset = 7;
        const angle = Math.atan2(dy, dx);
        const offset = Math.min(dist / 16, maxOffset);

        const offsetX = Math.cos(angle) * offset;
        const offsetY = Math.sin(angle) * offset;

        (pupil as HTMLElement).style.transform = `translate(${offsetX}px, ${offsetY}px)`;
      });
      ticking = false;
    }

    window.addEventListener('mousemove', (e) => {
      mouseX = e.clientX;
      mouseY = e.clientY;
      if (!ticking) {
        requestAnimationFrame(updatePhotoPupils);
        ticking = true;
      }
    }, { passive: true });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupPhotoEyeTracking);
  } else {
    setupPhotoEyeTracking();
  }
</script>

<style>
  .bulldog-animated-container {
    width: 100%;
    max-width: 480px;
    margin: 0 auto;
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .logo-image-floating-wrapper {
    position: relative;
    width: 100%;
    max-width: 450px;
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .bulldog-gold-emblem-img {
    width: 100%;
    max-width: 440px;
    height: auto;
    display: block;
    filter: drop-shadow(0 16px 40px rgba(232, 166, 61, 0.45));
    transition: transform 0.4s var(--ease-out), filter 0.4s ease;
  }

  .bulldog-gold-emblem-img:hover {
    transform: scale(1.03) translateY(-4px);
    filter: drop-shadow(0 24px 55px rgba(232, 166, 61, 0.65));
  }

  /* Capa de cuencas de ojos interactivos posicionadas sobre la foto */
  .eye-tracker-overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    z-index: 10;
  }

  .photo-eye-socket {
    position: absolute;
    width: 26px;
    height: 26px;
    border-radius: 50%;
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .eye-socket-left {
    top: 51.8%;
    left: 39.5%;
    transform: translate(-50%, -50%);
  }

  .eye-socket-right {
    top: 51.8%;
    left: 60.5%;
    transform: translate(-50%, -50%);
  }

  .photo-pupil {
    width: 16px;
    height: 16px;
    position: relative;
    display: flex;
    justify-content: center;
    align-items: center;
    transition: transform 0.08s ease-out;
    will-change: transform;
  }

  .pupil-dot {
    width: 12px;
    height: 12px;
    background: var(--amber);
    border-radius: 50%;
    display: block;
    box-shadow: 0 0 8px rgba(232, 166, 61, 0.9);
  }

  :root.light-theme .pupil-dot {
    background: #d97706;
  }

  .pupil-shine {
    position: absolute;
    top: 1px;
    left: 1px;
    width: 5px;
    height: 5px;
    background: #ffffff;
    border-radius: 50%;
    opacity: 0.95;
  }
</style>
