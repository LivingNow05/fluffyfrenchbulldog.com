---
export interface Props {
  className?: string;
}

const { className = 'bulldog-hero-svg' } = Astro.props;
---

<div class={`bulldog-animated-container ${className}`}>
  <div class="logo-image-floating-wrapper">
    <img 
      src="/images/fluffy_logo.png" 
      alt="Dinastía Bulldog Fluffy Emblem" 
      class="bulldog-gold-emblem-img"
      loading="eager"
      width="340"
      height="340"
    />
  </div>
</div>

<style>
  .bulldog-animated-container {
    width: 100%;
    max-width: 360px;
    margin: 0 auto;
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .logo-image-floating-wrapper {
    position: relative;
    width: 100%;
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .bulldog-gold-emblem-img {
    width: 100%;
    max-width: 320px;
    height: auto;
    display: block;
    filter: drop-shadow(0 14px 35px rgba(232, 166, 61, 0.45));
    transition: transform 0.4s var(--ease-out), filter 0.4s ease;
  }

  .bulldog-gold-emblem-img:hover {
    transform: scale(1.04) translateY(-4px);
    filter: drop-shadow(0 22px 50px rgba(232, 166, 61, 0.65));
  }
</style>
