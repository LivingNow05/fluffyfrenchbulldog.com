---
export interface Props {
  className?: string;
}

const { className = 'bulldog-hero-svg' } = Astro.props;
---

<div class={`bulldog-animated-container ${className}`}>
  <svg viewBox="0 0 512 512" fill="none" xmlns="http://www.w3.org/2000/svg" class="bulldog-svg-element">
    <!-- Aureola Resplandor Dorado de Fondo -->
    <circle cx="256" cy="256" r="230" fill="url(#amber-glow)" opacity="0.35" />

    <g transform="translate(0, 0)">
      <!-- 1. Silueta Exterior y Contorno Tipo Sticker (Borde Negro Fuerte) -->
      <path d="M210 155 C185 100 155 40 115 40 C80 40 70 80 95 130 C115 170 125 195 132 215 C105 300 140 440 256 462 C372 440 407 300 380 215 C387 195 397 170 417 130 C442 80 432 40 397 40 C357 40 327 100 302 155 C272 163 240 163 210 155 Z" fill="#121316" stroke="#121316" stroke-width="16" stroke-linejoin="round"/>

      <!-- 2. Relleno Amarillo / Dorado Ámbar de la Cabeza y Orejas -->
      <path d="M210 155 C185 100 155 40 115 40 C80 40 70 80 95 130 C115 170 125 195 132 215 C105 300 140 440 256 462 C372 440 407 300 380 215 C387 195 397 170 417 130 C442 80 432 40 397 40 C357 40 327 100 302 155 C272 163 240 163 210 155 Z" fill="url(#amber-gold-grad)"/>

      <!-- 3. Profundidad Interior de las Orejas de Murciélago (Ámbar cálido) -->
      <path d="M125 75 C105 75 98 100 112 135 C126 165 140 180 155 185 C145 155 135 110 125 75 Z" fill="#d48c28" opacity="0.5"/>
      <path d="M387 75 C407 75 414 100 400 135 C386 165 372 180 357 185 C367 155 377 110 387 75 Z" fill="#d48c28" opacity="0.5"/>

      <!-- 4. Parche Negro Orgánico en el Ojo Izquierdo y Mejilla Izquierda -->
      <path d="M190 170 C145 172 118 215 115 285 C112 350 142 410 200 418 C242 424 248 375 242 325 C236 270 245 220 212 182 C202 172 195 169 190 170 Z" fill="#121316"/>

      <!-- 5. OJO IZQUIERDO ANIMADO (Dentro del parche negro) -->
      <g class="animated-eye-left">
        <circle cx="185" cy="255" r="24" fill="#e8a63d"/>
        <circle cx="185" cy="255" r="16" fill="#121316"/>
        <g class="animated-pupil">
          <circle cx="185" cy="255" r="10" fill="#e8a63d"/>
          <circle cx="185" cy="255" r="6" fill="#121316"/>
          <circle cx="181" cy="250" r="4" fill="#ffffff"/>
          <circle cx="189" cy="259" r="2" fill="#ffffff" opacity="0.8"/>
        </g>
      </g>

      <!-- 6. OJO DERECHO ANIMADO (Sobre el lado dorado) -->
      <g class="animated-eye-right">
        <circle cx="327" cy="255" r="26" fill="#121316"/>
        <circle cx="327" cy="255" r="17" fill="#e8a63d"/>
        <g class="animated-pupil">
          <circle cx="327" cy="255" r="10" fill="#121316"/>
          <circle cx="323" cy="250" r="4.5" fill="#ffffff"/>
          <circle cx="331" cy="259" r="2" fill="#ffffff" opacity="0.8"/>
        </g>
      </g>

      <!-- 7. Arruga / Pliegue del Hocico Superior -->
      <path d="M215 282 C238 272 274 272 297 282 C285 292 227 292 215 282 Z" fill="#121316" opacity="0.25"/>

      <!-- 8. Hocico Negro Prominente -->
      <path d="M256 295 C212 295 182 322 182 360 C182 402 218 422 256 422 C294 422 330 402 330 360 C330 322 300 295 256 295 Z" fill="#121316"/>

      <!-- 9. Trufa / Nariz Negra Destacada -->
      <path d="M226 318 C240 312 272 312 286 318 C298 324 294 346 278 354 C266 360 246 360 234 354 C218 346 214 324 226 318 Z" fill="#22252c"/>
      <path d="M238 336 C234 340 234 348 242 346 C246 345 246 338 240 336 Z" fill="#09090b"/>
      <path d="M274 336 C278 340 278 348 270 346 C266 345 266 338 272 336 Z" fill="#09090b"/>
      <ellipse cx="256" cy="322" rx="14" ry="4" fill="#ffffff" opacity="0.35"/>

      <!-- 10. Líneas de la Boca -->
      <path d="M218 376 Q256 394 294 376" stroke="#e8a63d" stroke-width="4" stroke-linecap="round" fill="none" opacity="0.7"/>

      <!-- 11. LENGÜITA ANIMADA (Salida hacia el lado inferior derecho) -->
      <g class="animated-tongue-group">
        <path d="M265 382 C262 404 274 425 292 426 C306 427 315 412 305 394 C298 384 282 380 265 382 Z" fill="#ff6b81" stroke="#121316" stroke-width="3.5" stroke-linejoin="round"/>
        <path d="M280 385 C284 398 290 412 295 422" stroke="#e04860" stroke-width="2.5" stroke-linecap="round"/>
      </g>
    </g>

    <!-- Gradientes de Marca -->
    <defs>
      <radialGradient id="amber-glow" cx="0" cy="0" r="1" gradientUnits="userSpaceOnUse" gradientTransform="translate(256 256) scale(230)">
        <stop stop-color="#e8a63d" stop-opacity="0.6"/>
        <stop offset="0.7" stop-color="#f6c96d" stop-opacity="0.15"/>
        <stop offset="1" stop-color="#e8a63d" stop-opacity="0"/>
      </radialGradient>

      <linearGradient id="amber-gold-grad" x1="120" y1="40" x2="390" y2="460" gradientUnits="userSpaceOnUse">
        <stop stop-color="#f7ce76"/>
        <stop offset="0.45" stop-color="#e8a63d"/>
        <stop offset="1" stop-color="#d48c28"/>
      </linearGradient>
    </defs>
  </svg>
</div>

<style>
  .bulldog-animated-container {
    width: 100%;
    max-width: 320px;
    margin: 0 auto;
    display: flex;
    justify-content: center;
    align-items: center;
    filter: drop-shadow(0 10px 25px rgba(232, 166, 61, 0.25));
  }

  .bulldog-svg-element {
    width: 100%;
    height: auto;
    overflow: visible;
  }

  /* Animación de los Ojos: Mirada curiosa a los lados y parpadeo suave */
  .animated-pupil {
    animation: eyeMove 4s ease-in-out infinite alternate;
  }

  .animated-eye-left, .animated-eye-right {
    animation: eyeBlink 5s ease-in-out infinite;
    transform-origin: 256px 255px;
  }

  @keyframes eyeMove {
    0%, 20% { transform: translateX(0px) translateY(0px); }
    35%, 55% { transform: translateX(-5px) translateY(-2px); }
    70%, 90% { transform: translateX(5px) translateY(1px); }
    100% { transform: translateX(0px) translateY(0px); }
  }

  @keyframes eyeBlink {
    0%, 94%, 98%, 100% { transform: scaleY(1); }
    96% { transform: scaleY(0.1); }
  }

  /* Animación de la Lengüita: Jadeo / Movimiento dinámico a la derecha */
  .animated-tongue-group {
    transform-origin: 280px 382px;
    animation: tonguePant 1.4s ease-in-out infinite alternate;
  }

  @keyframes tonguePant {
    0% {
      transform: translateY(0px) rotate(-3deg) scale(1);
    }
    50% {
      transform: translateY(3px) rotate(2deg) scale(1.06);
    }
    100% {
      transform: translateY(1px) rotate(5deg) scale(1.02);
    }
  }
</style>
