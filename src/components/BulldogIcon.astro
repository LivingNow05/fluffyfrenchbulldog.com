---
export interface Props {
  className?: string;
}

const { className = 'bulldog-hero-svg' } = Astro.props;
---

<div class={`bulldog-animated-container ${className}`}>
  <svg viewBox="0 0 512 512" fill="none" xmlns="http://www.w3.org/2000/svg" class="bulldog-svg-element">
    <defs>
      <radialGradient id="amber-glow-friendly" cx="0" cy="0" r="1" gradientUnits="userSpaceOnUse" gradientTransform="translate(256 256) scale(230)">
        <stop stop-color="#e8a63d" stop-opacity="0.45"/>
        <stop offset="0.75" stop-color="#f6c96d" stop-opacity="0.12"/>
        <stop offset="1" stop-color="#e8a63d" stop-opacity="0"/>
      </radialGradient>
    </defs>

    <!-- Aura de Resplandor Dorado de Fondo (Sin cajas ni bordes) -->
    <circle cx="256" cy="256" r="220" fill="url(#amber-glow-friendly)" opacity="0.65" />

    <g stroke="#e8a63d" stroke-width="16" stroke-linecap="round" stroke-linejoin="round" class="logo-gold-stroke">
      <!-- Oreja Izquierda (Curva redondeada y mechones fluffy exteriores) -->
      <path d="M 200 170 C 180 120 142 80 115 85 C 92 90 90 120 108 152 C 122 178 135 198 145 220" />
      <path d="M 118 108 Q 88 100 98 120 Q 75 135 94 150 Q 72 168 96 182 Q 82 200 110 208" />
      <path d="M 178 150 C 158 120 135 98 122 102 C 114 105 115 125 128 152" stroke-width="11" opacity="0.85" />

      <!-- Oreja Derecha (Curva redondeada y mechones fluffy exteriores) -->
      <path d="M 312 170 C 332 120 370 80 397 85 C 420 90 422 120 404 152 C 390 178 377 198 367 220" />
      <path d="M 394 108 Q 424 100 414 120 Q 437 135 418 150 Q 440 168 416 182 Q 430 200 402 208" />
      <path d="M 334 150 C 354 120 377 98 390 102 C 398 105 397 125 384 152" stroke-width="11" opacity="0.85" />

      <!-- Puente de la Cabeza -->
      <path d="M 200 170 C 220 162 292 162 312 170" />

      <!-- Contorno de la Cabeza y Mejillas -->
      <path d="M 145 220 C 120 270 125 385 256 425 C 387 385 392 270 367 220" />

      <!-- Ojos Amigables y Expresivos (Rellenos dorados con destello blanco) -->
      <g class="animated-eye-left">
        <circle cx="192" cy="265" r="22" fill="#e8a63d" stroke="none" class="eye-fill" />
        <circle cx="187" cy="260" r="6" fill="#ffffff" stroke="none" />
      </g>
      <g class="animated-eye-right">
        <circle cx="320" cy="265" r="22" fill="#e8a63d" stroke="none" class="eye-fill" />
        <circle cx="315" cy="260" r="6" fill="#ffffff" stroke="none" />
      </g>

      <!-- Hocico y Mofletes -->
      <path d="M 256 295 C 205 295 174 325 174 368 C 174 412 215 425 256 425 C 297 425 338 412 338 368 C 338 325 307 295 256 295 Z" fill="none" />

      <!-- Trufa / Nariz -->
      <path d="M 226 325 C 238 315 274 315 286 325 C 298 335 294 358 278 365 C 266 370 246 370 234 365 C 218 358 214 335 226 325 Z" fill="#e8a63d" stroke="none" class="nose-fill" />
      <path d="M 256 365 L 256 385" stroke-width="14" />

      <!-- Sonrisa Amigable Curva -->
      <path d="M 220 385 Q 256 410 292 385" stroke-width="14" fill="none" />
    </g>
  </svg>
</div>

<style>
  .bulldog-animated-container {
    width: 100%;
    max-width: 360px;
    margin: 0 auto;
    display: flex;
    justify-content: center;
    align-items: center;
    filter: drop-shadow(0 14px 35px rgba(232, 166, 61, 0.35));
  }

  .bulldog-svg-element {
    width: 100%;
    height: auto;
    overflow: visible;
  }

  .logo-gold-stroke {
    color: var(--amber);
  }
  :root.light-theme .logo-gold-stroke {
    stroke: #d97706;
  }
  :root.light-theme .eye-fill,
  :root.light-theme .nose-fill {
    fill: #d97706;
  }

  /* Animación suave de parpadeo */
  .animated-eye-left, .animated-eye-right {
    animation: logoBlink 5s ease-in-out infinite;
    transform-origin: 256px 265px;
  }

  @keyframes logoBlink {
    0%, 94%, 98%, 100% { transform: scaleY(1); }
    96% { transform: scaleY(0.1); }
  }
</style>
