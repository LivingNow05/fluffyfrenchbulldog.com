---
export interface Props {
  className?: string;
}

const { className = 'bulldog-hero-svg' } = Astro.props;
---

<div class={`bulldog-animated-container ${className}`}>
  <div class="logo-image-floating-wrapper">
    <!-- Halo Aura Glow de Fondo -->
    <div class="emblem-halo-ring"></div>
    <div class="emblem-pulse-ring"></div>

    <!-- Foto PNG Base del Bulldog (Sin recuadro, transparente) -->
    <img 
      src="/images/fluffy_logo.png" 
      alt="Dinastía Bulldog Fluffy Emblem" 
      class="bulldog-gold-emblem-img"
      loading="eager"
      width="500"
      height="500"
    />
    
    <!-- Capa de Ojos Lux Exóticos Interactivos sobre la Foto -->
    <div class="eye-tracker-overlay">
      <div class="photo-eye-socket eye-socket-left">
        <div class="photo-pupil js-photo-pupil" id="photo-pupil-l">
          <div class="iris-ring">
            <span class="pupil-center"></span>
            <span class="pupil-shine-main"></span>
            <span class="pupil-shine-sec"></span>
          </div>
        </div>
      </div>
      <div class="photo-eye-socket eye-socket-right">
        <div class="photo-pupil js-photo-pupil" id="photo-pupil-r">
          <div class="iris-ring">
            <span class="pupil-center"></span>
            <span class="pupil-shine-main"></span>
            <span class="pupil-shine-sec"></span>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  function setupPhotoEyeTracking() {
    const pupils = document.querySelectorAll('.js-photo-pupil');
    if (!pupils.length) return;

    let mouseX = window.innerWidth / 2;
    let mouseY = window.innerHeight / 2;
    let ticking = false;

    function updatePhotoPupils() {
      pupils.forEach((pupil) => {
        const rect = pupil.getBoundingClientRect();
        const eyeCenterX = rect.left + rect.width / 2;
        const eyeCenterY = rect.top + rect.height / 2;

        const dx = mouseX - eyeCenterX;
        const dy = mouseY - eyeCenterY;
        const dist = Math.hypot(dx, dy);

        // Máximo desplazamiento suave dentro del ojo (360º tracking)
        const maxOffset = 10;
        const angle = Math.atan2(dy, dx);
        const offset = Math.min(dist / 14, maxOffset);

        const offsetX = Math.cos(angle) * offset;
        const offsetY = Math.sin(angle) * offset;

        (pupil as HTMLElement).style.transform = `translate(${offsetX}px, ${offsetY}px)`;
      });
      ticking = false;
    }

    window.addEventListener('mousemove', (e) => {
      mouseX = e.clientX;
      mouseY = e.clientY;
      if (!ticking) {
        requestAnimationFrame(updatePhotoPupils);
        ticking = true;
      }
    }, { passive: true });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupPhotoEyeTracking);
  } else {
    setupPhotoEyeTracking();
  }
  document.addEventListener('astro:page-load', setupPhotoEyeTracking);
</script>

<style>
  .bulldog-animated-container {
    width: 100%;
    max-width: 560px;
    margin: 0 auto;
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .logo-image-floating-wrapper {
    position: relative;
    width: 100%;
    max-width: 520px;
    display: flex;
    justify-content: center;
    align-items: center;
    animation: emblemFloat 7s ease-in-out infinite alternate;
  }

  @keyframes emblemFloat {
    0% { transform: translateY(0px); }
    50% { transform: translateY(-8px); }
    100% { transform: translateY(4px); }
  }

  .emblem-halo-ring {
    position: absolute;
    width: 75%;
    height: 75%;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(232, 166, 61, 0.28) 0%, rgba(212, 146, 40, 0.08) 55%, transparent 75%);
    filter: blur(30px);
    pointer-events: none;
    z-index: 0;
  }

  .emblem-pulse-ring {
    position: absolute;
    width: 65%;
    height: 65%;
    border-radius: 50%;
    border: 1px solid rgba(232, 166, 61, 0.25);
    box-shadow: 0 0 35px rgba(232, 166, 61, 0.2);
    pointer-events: none;
    z-index: 0;
    animation: ringPulse 4s ease-in-out infinite alternate;
  }

  @keyframes ringPulse {
    0% { transform: scale(0.95); opacity: 0.4; }
    100% { transform: scale(1.08); opacity: 0.8; }
  }

  .bulldog-gold-emblem-img {
    position: relative;
    z-index: 2;
    width: 100%;
    max-width: 500px;
    height: auto;
    display: block;
    filter: drop-shadow(0 20px 48px rgba(232, 166, 61, 0.5));
    transition: transform 0.4s var(--ease-out), filter 0.4s ease;
  }

  .bulldog-gold-emblem-img:hover {
    transform: scale(1.03) translateY(-6px);
    filter: drop-shadow(0 28px 65px rgba(232, 166, 61, 0.75));
  }

  /* Capa de cuencas de ojos exóticos interactivos */
  .eye-tracker-overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    z-index: 10;
  }

  .photo-eye-socket {
    position: absolute;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .eye-socket-left {
    top: 51.8%;
    left: 39.5%;
    transform: translate(-50%, -50%);
  }

  .eye-socket-right {
    top: 51.8%;
    left: 60.5%;
    transform: translate(-50%, -50%);
  }

  .photo-pupil {
    width: 22px;
    height: 22px;
    position: relative;
    display: flex;
    justify-content: center;
    align-items: center;
    transition: transform 0.08s ease-out;
    will-change: transform;
  }

  /* Anillo del Iris Exótico Dorado Sol brillante */
  .iris-ring {
    width: 20px;
    height: 20px;
    border-radius: 50%;
    background: radial-gradient(circle at 35% 35%, #fef08a 0%, #f59e0b 55%, #b45309 100%);
    box-shadow: 0 0 14px rgba(245, 158, 11, 0.95), inset 0 0 4px rgba(0, 0, 0, 0.6);
    position: relative;
    display: flex;
    justify-content: center;
    align-items: center;
    transition: box-shadow 0.3s ease;
  }

  :root.light-theme .iris-ring {
    background: radial-gradient(circle at 35% 35%, #fbbf24 0%, #d97706 70%, #92400e 100%);
  }

  /* Centro de la Pupila Oscura */
  .pupil-center {
    width: 11px;
    height: 11px;
    background: #0f172a;
    border-radius: 50%;
    display: block;
  }

  /* Destello Principal */
  .pupil-shine-main {
    position: absolute;
    top: 2px;
    left: 3px;
    width: 5px;
    height: 5px;
    background: #ffffff;
    border-radius: 50%;
    opacity: 0.95;
  }

  /* Destello Secundario */
  .pupil-shine-sec {
    position: absolute;
    bottom: 3px;
    right: 3px;
    width: 2.5px;
    height: 2.5px;
    background: rgba(255, 255, 255, 0.8);
    border-radius: 50%;
  }
</style>

