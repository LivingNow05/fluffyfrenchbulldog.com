---
export interface Props {
  className?: string;
}

const { className = 'bulldog-hero-svg' } = Astro.props;
---

<div class={`bulldog-animated-container ${className}`}>
  <svg viewBox="0 0 512 512" fill="none" xmlns="http://www.w3.org/2000/svg" class="bulldog-svg-element">
    <defs>
      <radialGradient id="amber-glow-logo" cx="0" cy="0" r="1" gradientUnits="userSpaceOnUse" gradientTransform="translate(256 256) scale(220)">
        <stop stop-color="#e8a63d" stop-opacity="0.4"/>
        <stop offset="0.75" stop-color="#f6c96d" stop-opacity="0.1"/>
        <stop offset="1" stop-color="#e8a63d" stop-opacity="0"/>
      </radialGradient>
    </defs>

    <!-- Resplandor Dorado de Fondo -->
    <circle cx="256" cy="256" r="220" fill="url(#amber-glow-logo)" opacity="0.55" />

    <g class="logo-gold-stroke" stroke="#e8a63d" stroke-width="12" stroke-linecap="round" stroke-linejoin="round">
      
      <!-- 1. OREJA IZQUIERDA (Proporcionada/compacta con mechones de pelo fluffy al exterior) -->
      <path d="M 188 152 C 170 120 152 75 185 45 C 215 22 238 52 232 108" />
      <!-- Mechones de pelaje exterior oreja izquierda -->
      <path d="M 175 130 Q 142 122 152 142 Q 130 158 155 172 Q 138 190 162 198 Q 148 214 175 218" />
      <!-- Trazo interior oreja izquierda -->
      <path d="M 190 115 C 180 92 180 62 192 48 C 205 35 218 52 214 90" stroke-width="8" opacity="0.85" />

      <!-- 2. OREJA DERECHA (Proporcionada/compacta con mechones de pelo fluffy al exterior) -->
      <path d="M 324 152 C 342 120 360 75 327 45 C 297 22 274 52 280 108" />
      <!-- Mechones de pelaje exterior oreja derecha -->
      <path d="M 337 130 Q 370 122 360 142 Q 382 158 357 172 Q 374 190 350 198 Q 364 214 337 218" />
      <!-- Trazo interior oreja derecha -->
      <path d="M 322 115 C 332 92 332 62 320 48 C 307 35 294 52 298 90" stroke-width="8" opacity="0.85" />

      <!-- 3. PUENTE SUPERIOR DE LA CABEZA ENTRE OREJAS -->
      <path d="M 232 108 Q 244 94 256 102 Q 268 94 280 108" />

      <!-- 4. CONTORNO EXTERIOR DE CABEZA Y MEJILLAS CON MECHONES FLUFFY PROYECTADOS HACIA AFUERA -->
      <path d="M 175 218 Q 148 232 165 248 Q 138 268 162 285 Q 142 308 170 326 Q 152 350 188 368 Q 175 392 210 408 C 232 418 280 418 302 408 Q 337 392 324 368 Q 360 350 342 326 Q 370 308 350 285 Q 374 268 347 248 Q 364 232 337 218" />

      <!-- 5. OJOS CIRCULARES RELLENOS DORADOS -->
      <g class="animated-eye-left">
        <circle cx="215" cy="250" r="16" fill="#e8a63d" stroke="none" class="eye-fill" />
        <circle cx="212" cy="246" r="4" fill="#ffffff" stroke="none" />
      </g>
      <g class="animated-eye-right">
        <circle cx="297" cy="250" r="16" fill="#e8a63d" stroke="none" class="eye-fill" />
        <circle cx="294" cy="246" r="4" fill="#ffffff" stroke="none" />
      </g>

      <!-- 6. HOCICO Y TRUFA -->
      <path d="M 205 305 C 190 305 178 322 178 348 C 178 382 212 400 256 400 C 300 400 334 382 334 348 C 334 322 322 305 307 305 C 285 305 272 325 256 325 C 240 325 227 305 205 305 Z" />

      <!-- Trufa / Nariz prominente -->
      <path d="M 238 335 Q 256 322 274 335 Q 278 348 256 352 Q 234 348 238 335 Z" fill="#e8a63d" stroke="none" class="nose-fill" />
      <!-- Línea vertical hacia la boca y comisura -->
      <path d="M 256 352 L 256 372" stroke-width="10" />
      <path d="M 236 374 Q 256 388 276 374" stroke-width="10" />

    </g>
  </svg>
</div>

<style>
  .bulldog-animated-container {
    width: 100%;
    max-width: 320px;
    margin: 0 auto;
    display: flex;
    justify-content: center;
    align-items: center;
    filter: drop-shadow(0 12px 30px rgba(232, 166, 61, 0.3));
  }

  .bulldog-svg-element {
    width: 100%;
    height: auto;
    overflow: visible;
  }

  .logo-gold-stroke {
    color: var(--amber);
  }
  :root.light-theme .logo-gold-stroke {
    stroke: #d97706;
  }
  :root.light-theme .eye-fill,
  :root.light-theme .nose-fill {
    fill: #d97706;
  }

  /* Animación suave de parpadeo */
  .animated-eye-left, .animated-eye-right {
    animation: logoBlink 5s ease-in-out infinite;
    transform-origin: 256px 250px;
  }

  @keyframes logoBlink {
    0%, 94%, 98%, 100% { transform: scaleY(1); }
    96% { transform: scaleY(0.1); }
  }
</style>
