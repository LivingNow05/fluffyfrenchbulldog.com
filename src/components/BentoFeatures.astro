---

<section id="features" class="bento-section scroll-mt">
  <div class="wrap">
    <div class="bento-header">
      <span class="bento-kicker">💎 EXCELENCIA GENÉTICA</span>
      <h2 class="bento-title">El Estándar de la Realeza Canina</h2>
      <p class="bento-lead">Criamos la más alta gama de Bulldog Francés Fluffy combinando salud de hierro, genética exótica y un servicio de entrega global cinco estrellas.</p>
    </div>

    <div class="bento-grid">
      <!-- Tarjeta 1: Genética (Grande, span 2) -->
      <div class="bento-card bento-card--large tilt-element" data-tilt>
        <div class="bento-card-inner">
          <div class="bento-icon-wrapper float-3d">
            <span class="bento-icon">🧬</span>
          </div>
          <h3>Especialistas en el Gen Fluffy</h3>
          <p>Dominamos la cría de cachorros portadores y visuales del gen de pelo largo (L4), logrando mantos afelpados incomparables en colores exóticos como Blue, Isabella, Lilac, Cocoa y Merlé.</p>
          <div class="bento-visual 3d-pop">
            <div class="dna-strand"></div>
          </div>
        </div>
      </div>

      <!-- Tarjeta 2: Envíos VIP -->
      <div class="bento-card tilt-element" data-tilt>
        <div class="bento-card-inner">
          <div class="bento-icon-wrapper float-3d" style="animation-delay: 0.5s;">
            <span class="bento-icon">✈️</span>
          </div>
          <h3>Envíos VIP en Cabina</h3>
          <p>Entrega personalizada por "Flight Nannies" directo en tus brazos, en más de 100 aeropuertos a nivel global sin escalas en bodega.</p>
        </div>
      </div>

      <!-- Tarjeta 3: Certificación y Pedigree -->
      <div class="bento-card tilt-element" data-tilt>
        <div class="bento-card-inner">
          <div class="bento-icon-wrapper float-3d" style="animation-delay: 1s;">
            <span class="bento-icon">📜</span>
          </div>
          <h3>Pedigree AKC / FCI</h3>
          <p>Linajes puros certificados por el American Kennel Club y la Fédération Cynologique Internationale, asegurando morfología de campeones.</p>
        </div>
      </div>

      <!-- Tarjeta 4: Garantía (Larga) -->
      <div class="bento-card bento-card--wide tilt-element" data-tilt>
        <div class="bento-card-inner">
          <div class="bento-flex-content">
            <div class="bento-text-side">
              <div class="bento-icon-wrapper float-3d" style="animation-delay: 1.5s;">
                <span class="bento-icon">🏥</span>
              </div>
              <h3>Garantía Genética de 2 Años</h3>
              <p>Nuestros cachorros pasan rigurosos controles veterinarios y pruebas de ADN. Tu inversión está respaldada por una garantía escrita inigualable en el mercado de criadores élite.</p>
            </div>
            <div class="bento-badge-side 3d-pop">
              <div class="gold-badge">100% HEALTH<br/>GUARANTEE</div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .bento-section {
    padding: 80px 0;
    position: relative;
    overflow: hidden;
  }

  .bento-header {
    text-align: center;
    max-width: 680px;
    margin: 0 auto 48px;
    perspective: 1000px;
  }

  .bento-kicker {
    display: inline-block;
    padding: 6px 16px;
    background: rgba(147, 51, 234, 0.08);
    border: 1px solid rgba(147, 51, 234, 0.2);
    border-radius: 999px;
    font-size: 0.8rem;
    font-weight: 800;
    color: var(--brand-bright);
    margin-bottom: 16px;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }
  
  html.dark .bento-kicker {
    background: rgba(192, 132, 252, 0.1);
    border-color: rgba(192, 132, 252, 0.3);
  }

  .bento-title {
    font-size: clamp(2rem, 4vw, 3.2rem);
    font-weight: 850;
    margin: 0 0 16px;
    color: var(--ink);
    letter-spacing: -0.02em;
    line-height: 1.1;
  }

  .bento-lead {
    font-size: 1.1rem;
    color: var(--ink-soft);
    margin: 0;
    line-height: 1.6;
  }

  .bento-grid {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    grid-auto-rows: minmax(280px, auto);
    gap: 24px;
    perspective: 2000px; /* Para los efectos 3D */
  }

  .bento-card {
    grid-column: span 12;
    border-radius: 24px;
    background: var(--surface);
    border: 1px solid var(--border);
    box-shadow: 0 10px 40px -10px rgba(0,0,0,0.05);
    position: relative;
    transform-style: preserve-3d;
    transition: box-shadow 0.4s ease;
    cursor: pointer;
    /* Sombras base suaves */
  }
  
  html.dark .bento-card {
    background: rgba(30, 27, 46, 0.6);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border-color: rgba(255, 255, 255, 0.08);
    box-shadow: 0 20px 50px -20px rgba(0,0,0,0.5), inset 0 1px 0 rgba(255,255,255,0.1);
  }

  .bento-card:hover {
    box-shadow: 0 30px 60px -15px rgba(147, 51, 234, 0.2);
  }
  
  html.dark .bento-card:hover {
    box-shadow: 0 30px 60px -15px rgba(192, 132, 252, 0.15), inset 0 1px 0 rgba(255,255,255,0.2);
  }

  /* Grid Spans para Desktop */
  @media (min-width: 900px) {
    .bento-card--large {
      grid-column: span 8;
      grid-row: span 2;
    }
    .bento-card:not(.bento-card--large):not(.bento-card--wide) {
      grid-column: span 4;
    }
    .bento-card--wide {
      grid-column: span 8;
    }
  }

  /* Contenido interno y Z-index 3D */
  .bento-card-inner {
    padding: 40px;
    height: 100%;
    display: flex;
    flex-direction: column;
    transform: translateZ(40px); /* 3D POP EFFECT BASE */
    transform-style: preserve-3d;
  }

  .bento-icon-wrapper {
    width: 56px;
    height: 56px;
    border-radius: 16px;
    background: linear-gradient(135deg, var(--brand-accent), var(--brand-dark));
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 24px;
    box-shadow: 0 8px 20px rgba(147, 51, 234, 0.3);
  }

  .bento-icon {
    font-size: 1.8rem;
    filter: drop-shadow(0 2px 4px rgba(0,0,0,0.2));
  }

  .bento-card h3 {
    font-size: 1.6rem;
    font-weight: 800;
    margin: 0 0 12px;
    color: var(--ink);
    line-height: 1.2;
    transform: translateZ(20px);
  }

  .bento-card p {
    font-size: 1.05rem;
    color: var(--ink-soft);
    margin: 0;
    line-height: 1.6;
    transform: translateZ(10px);
  }

  /* Efecto Visual DNA para Tarjeta Larga */
  .bento-visual {
    margin-top: 32px;
    flex-grow: 1;
    background: linear-gradient(45deg, rgba(147,51,234,0.05), rgba(79,70,229,0.05));
    border-radius: 16px;
    border: 1px dashed rgba(147,51,234,0.3);
    position: relative;
    min-height: 120px;
    overflow: hidden;
  }
  
  html.dark .bento-visual {
    background: linear-gradient(45deg, rgba(192,132,252,0.1), rgba(129,140,248,0.1));
    border-color: rgba(192,132,252,0.3);
  }

  /* Animaciones 3D */
  @keyframes float-up-down {
    0%, 100% { transform: translateY(0) translateZ(50px); }
    50% { transform: translateY(-10px) translateZ(50px); }
  }

  .float-3d {
    animation: float-up-down 4s ease-in-out infinite;
  }

  .3d-pop {
    transform: translateZ(60px);
    transition: transform 0.3s ease;
  }
  
  .tilt-element:hover .3d-pop {
    transform: translateZ(90px) scale(1.05);
  }

  /* Flex Layout para Tarjeta Wide */
  .bento-flex-content {
    display: flex;
    gap: 32px;
    height: 100%;
    align-items: center;
    transform-style: preserve-3d;
  }
  
  .bento-text-side {
    flex: 1;
    transform-style: preserve-3d;
  }
  
  .bento-badge-side {
    width: 140px;
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .gold-badge {
    width: 120px;
    height: 120px;
    background: linear-gradient(135deg, #FFDF73, #D4AF37, #996515);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    font-size: 0.8rem;
    font-weight: 900;
    color: #4A3500;
    border: 4px solid rgba(255,255,255,0.2);
    box-shadow: 0 20px 40px rgba(212, 175, 55, 0.4), inset 0 4px 10px rgba(255,255,255,0.5);
    text-transform: uppercase;
    line-height: 1.2;
    transform: rotateZ(10deg);
  }

  @media (max-width: 768px) {
    .bento-flex-content {
      flex-direction: column;
      align-items: flex-start;
    }
    .bento-badge-side {
      margin-top: 24px;
      align-self: center;
    }
  }
</style>

<script is:inline>
  // Implementación Vanilla JS para Tilt 3D
  function init3DBento() {
    const cards = document.querySelectorAll('.tilt-element');
    
    cards.forEach(card => {
      // Sensibilidad del efecto (mayor = menos rotación)
      const sensitivity = 40; 
      
      card.addEventListener('mousemove', (e) => {
        // Obtener dimensiones y posición de la tarjeta
        const rect = card.getBoundingClientRect();
        
        // Calcular posición del ratón relativa a la tarjeta (en pixeles)
        const x = e.clientX - rect.left;
        const y = e.clientY - rect.top;
        
        // Convertir a porcentajes (-0.5 a 0.5) donde 0,0 es el centro
        const xPct = (x / rect.width) - 0.5;
        const yPct = (y / rect.height) - 0.5;
        
        // Calcular rotación en grados
        const rotateX = -yPct * sensitivity;
        const rotateY = xPct * sensitivity;
        
        // Aplicar transformación
        card.style.transform = `perspective(1000px) rotateX(${rotateX}deg) rotateY(${rotateY}deg) scale3d(1.02, 1.02, 1.02)`;
        card.style.transition = 'transform 0.1s cubic-bezier(0.25, 0.46, 0.45, 0.94)';
      });
      
      card.addEventListener('mouseleave', () => {
        // Restaurar estado original
        card.style.transform = `perspective(1000px) rotateX(0deg) rotateY(0deg) scale3d(1, 1, 1)`;
        card.style.transition = 'transform 0.5s cubic-bezier(0.25, 0.46, 0.45, 0.94)';
      });
    });
  }

  // Ejecutar al cargar
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init3DBento);
  } else {
    init3DBento();
  }
</script>
