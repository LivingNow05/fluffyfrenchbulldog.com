---
---

<section id="features" class="bento-section scroll-mt">
  <div class="wrap">
    <div class="bento-header">
      <span class="bento-kicker">💎 EXCELENCIA GENÉTICA</span>
      <h2 class="bento-title">El Estándar de la Realeza Canina</h2>
      <p class="bento-lead">Criamos la más alta gama de Bulldog Francés Fluffy combinando salud de hierro, genética exótica y un servicio de entrega global cinco estrellas.</p>
    </div>

    <div class="bento-grid">
      <!-- Tarjeta 1: Genética (Grande, span 2) -->
      <div class="bento-card bento-card--large tilt-element" data-tilt>
        <div class="bento-card-inner">
          <div class="bento-card-header">
            <div class="bento-icon-wrapper float-3d">
              <span class="bento-icon">🧬</span>
            </div>
            <span class="bento-tag">GEN L4 AFELPADO</span>
          </div>
          <h3>Especialistas en el Gen Fluffy</h3>
          <p>Dominamos la cría de cachorros portadores y visuales del gen de pelo largo (L4), logrando mantos afelpados incomparables en colores exóticos como Blue, Isabella, Lilac, Cocoa y Merlé.</p>
          
          <div class="bento-visual 3d-pop">
            <img src="/images/variedades/fluffy-visual-isabella.jpg" alt="Bulldog Francés Fluffy Visual Isabella" class="bento-img" loading="lazy" />
            <div class="bento-img-overlay"></div>
            <div class="bento-floating-pill float-3d-slow">
              <span class="pill-sparkle">✨</span>
              <span>100% Pura Raza & Gen Fluffy</span>
            </div>
          </div>
        </div>
      </div>

      <!-- Tarjeta 2: Envíos VIP -->
      <div class="bento-card tilt-element" data-tilt>
        <div class="bento-card-inner">
          <div class="bento-card-header">
            <div class="bento-icon-wrapper float-3d" style="animation-delay: 0.5s;">
              <span class="bento-icon">✈️</span>
            </div>
            <span class="bento-tag">GLOBAL DELIVERY</span>
          </div>
          <h3>Envíos VIP en Cabina</h3>
          <p>Entrega personalizada por "Flight Nannies" directo en tus brazos, en más de 100 aeropuertos a nivel global sin escalas en bodega.</p>
          
          <div class="bento-visual bento-visual--sm 3d-pop">
            <img src="/images/variedades/fluffy-blue.jpg" alt="Entrega VIP Bulldog Francés Fluffy Blue" class="bento-img" loading="lazy" />
            <div class="bento-img-overlay"></div>
            <div class="bento-mini-badge float-3d-slow" style="animation-delay: 0.7s;">
              ✈️ Flight Nanny Direct
            </div>
          </div>
        </div>
      </div>

      <!-- Tarjeta 3: Certificación y Pedigree -->
      <div class="bento-card tilt-element" data-tilt>
        <div class="bento-card-inner">
          <div class="bento-card-header">
            <div class="bento-icon-wrapper float-3d" style="animation-delay: 1s;">
              <span class="bento-icon">📜</span>
            </div>
            <span class="bento-tag">AKC & FCI</span>
          </div>
          <h3>Pedigree AKC / FCI</h3>
          <p>Linajes puros certificados por el American Kennel Club y la Fédération Cynologique Internationale, asegurando morfología de campeones.</p>

          <div class="bento-visual bento-visual--sm 3d-pop">
            <img src="/images/variedades/fluffy-lilac.jpg" alt="Pedigree Oficial AKC FCI Bulldog Francés Fluffy" class="bento-img" loading="lazy" />
            <div class="bento-img-overlay"></div>
            <div class="bento-mini-badge float-3d-slow" style="animation-delay: 1.2s;">
              👑 Registro Internacional
            </div>
          </div>
        </div>
      </div>

      <!-- Tarjeta 4: Garantía (Larga) -->
      <div class="bento-card bento-card--wide tilt-element" data-tilt>
        <div class="bento-card-inner">
          <div class="bento-flex-content">
            <div class="bento-text-side">
              <div class="bento-card-header">
                <div class="bento-icon-wrapper float-3d" style="animation-delay: 1.5s;">
                  <span class="bento-icon">🏥</span>
                </div>
                <span class="bento-tag">COBERTURA VETERINARIA</span>
              </div>
              <h3>Garantía Genética de 2 Años</h3>
              <p>Nuestros cachorros pasan rigurosos controles veterinarios y pruebas de ADN. Tu inversión está respaldada por una garantía escrita inigualable en el mercado de criadores élite.</p>
            </div>

            <div class="bento-guarantee-visual 3d-pop">
              <div class="bento-visual bento-visual--wide">
                <img src="/images/variedades/fluffy-merle.jpg" alt="Garantía de Salud Bulldog Francés Fluffy Merlé" class="bento-img" loading="lazy" />
                <div class="bento-img-overlay"></div>
              </div>
              <div class="gold-badge float-3d-slow">
                100% HEALTH<br/>GUARANTEE
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .bento-section {
    padding: 80px 0;
    position: relative;
    overflow: hidden;
  }

  .bento-header {
    text-align: center;
    max-width: 680px;
    margin: 0 auto 48px;
    perspective: 1000px;
  }

  .bento-kicker {
    display: inline-block;
    padding: 6px 16px;
    background: rgba(147, 51, 234, 0.08);
    border: 1px solid rgba(147, 51, 234, 0.2);
    border-radius: 999px;
    font-size: 0.8rem;
    font-weight: 800;
    color: var(--brand-bright);
    margin-bottom: 16px;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }
  
  html.dark .bento-kicker {
    background: rgba(192, 132, 252, 0.1);
    border-color: rgba(192, 132, 252, 0.3);
  }

  .bento-title {
    font-size: clamp(2rem, 4vw, 3.2rem);
    font-weight: 850;
    margin: 0 0 16px;
    color: var(--ink);
    letter-spacing: -0.02em;
    line-height: 1.1;
  }

  .bento-lead {
    font-size: 1.1rem;
    color: var(--ink-soft);
    margin: 0;
    line-height: 1.6;
  }

  .bento-grid {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    grid-auto-rows: minmax(280px, auto);
    gap: 24px;
    perspective: 2000px; /* Para los efectos 3D */
  }

  .bento-card {
    grid-column: span 12;
    border-radius: 24px;
    background: var(--surface);
    border: 1px solid var(--border);
    box-shadow: 0 10px 40px -10px rgba(0,0,0,0.05);
    position: relative;
    transform-style: preserve-3d;
    transition: box-shadow 0.4s ease;
    cursor: pointer;
    /* Sombras base suaves */
  }
  
  html.dark .bento-card {
    background: rgba(30, 27, 46, 0.6);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border-color: rgba(255, 255, 255, 0.08);
    box-shadow: 0 20px 50px -20px rgba(0,0,0,0.5), inset 0 1px 0 rgba(255,255,255,0.1);
  }

  .bento-card:hover {
    box-shadow: 0 30px 60px -15px rgba(147, 51, 234, 0.2);
  }
  
  html.dark .bento-card:hover {
    box-shadow: 0 30px 60px -15px rgba(192, 132, 252, 0.15), inset 0 1px 0 rgba(255,255,255,0.2);
  }

  /* Grid Spans para Desktop */
  @media (min-width: 900px) {
    .bento-card--large {
      grid-column: span 8;
      grid-row: span 2;
    }
    .bento-card:not(.bento-card--large):not(.bento-card--wide) {
      grid-column: span 4;
    }
    .bento-card--wide {
      grid-column: span 8;
    }
  }

  /* Contenido interno y Z-index 3D */
  .bento-card-inner {
    padding: 40px;
    height: 100%;
    display: flex;
    flex-direction: column;
    transform: translateZ(40px); /* 3D POP EFFECT BASE */
    transform-style: preserve-3d;
  }

  /* Header con Ícono y Tag */
  .bento-card-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 20px;
  }

  .bento-tag {
    font-size: 0.7rem;
    font-weight: 850;
    letter-spacing: 0.08em;
    padding: 4px 10px;
    border-radius: 999px;
    background: rgba(147, 51, 234, 0.08);
    color: var(--brand-bright);
    border: 1px solid rgba(147, 51, 234, 0.2);
    text-transform: uppercase;
    transform: translateZ(20px);
  }

  html.dark .bento-tag {
    background: rgba(192, 132, 252, 0.12);
    color: #c084fc;
    border-color: rgba(192, 132, 252, 0.3);
  }

  .bento-icon-wrapper {
    width: 52px;
    height: 52px;
    border-radius: 16px;
    background: linear-gradient(135deg, var(--brand-accent), var(--brand-dark));
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 8px 20px rgba(147, 51, 234, 0.3);
  }

  .bento-icon {
    font-size: 1.7rem;
    filter: drop-shadow(0 2px 4px rgba(0,0,0,0.2));
  }

  .bento-card h3 {
    font-size: 1.5rem;
    font-weight: 800;
    margin: 0 0 12px;
    color: var(--ink);
    line-height: 1.2;
    transform: translateZ(20px);
  }

  .bento-card p {
    font-size: 1.02rem;
    color: var(--ink-soft);
    margin: 0;
    line-height: 1.6;
    transform: translateZ(10px);
  }

  /* Contenedores de Imagen Visual */
  .bento-visual {
    margin-top: 24px;
    flex-grow: 1;
    border-radius: 18px;
    position: relative;
    min-height: 160px;
    overflow: hidden;
    border: 1px solid rgba(147,51,234,0.15);
    box-shadow: 0 12px 30px rgba(0,0,0,0.08);
  }

  html.dark .bento-visual {
    border-color: rgba(255,255,255,0.1);
    box-shadow: 0 16px 40px rgba(0,0,0,0.4);
  }

  .bento-visual--sm {
    min-height: 140px;
  }

  .bento-visual--wide {
    min-height: 160px;
    width: 100%;
  }

  .bento-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.6s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }

  .tilt-element:hover .bento-img {
    transform: scale(1.08);
  }

  .bento-img-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, transparent 40%, rgba(20, 14, 38, 0.65) 100%);
    pointer-events: none;
  }

  /* Badges y Pills Flotantes 3D */
  .bento-floating-pill {
    position: absolute;
    bottom: 14px;
    left: 14px;
    right: 14px;
    padding: 8px 14px;
    background: rgba(20, 14, 38, 0.82);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border: 1px solid rgba(192, 132, 252, 0.4);
    border-radius: 999px;
    font-size: 0.8rem;
    font-weight: 800;
    color: #fff;
    display: flex;
    align-items: center;
    gap: 8px;
    box-shadow: 0 8px 24px rgba(0,0,0,0.3);
  }

  .bento-mini-badge {
    position: absolute;
    bottom: 12px;
    left: 12px;
    padding: 6px 12px;
    background: rgba(20, 14, 38, 0.85);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border: 1px solid rgba(192, 132, 252, 0.35);
    border-radius: 12px;
    font-size: 0.75rem;
    font-weight: 800;
    color: #e9d5ff;
    box-shadow: 0 6px 16px rgba(0,0,0,0.3);
  }

  .bento-guarantee-visual {
    width: 220px;
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  /* Animaciones 3D Flotantes */
  @keyframes float-up-down {
    0%, 100% { transform: translateY(0) translateZ(50px); }
    50% { transform: translateY(-10px) translateZ(50px); }
  }

  @keyframes float-slow {
    0%, 100% { transform: translateY(0) translateZ(40px); }
    50% { transform: translateY(-6px) translateZ(40px); }
  }

  .float-3d {
    animation: float-up-down 4s ease-in-out infinite;
  }

  .float-3d-slow {
    animation: float-slow 3.5s ease-in-out infinite;
  }

  .3d-pop {
    transform: translateZ(50px);
    transition: transform 0.3s ease;
  }
  
  .tilt-element:hover .3d-pop {
    transform: translateZ(75px) scale(1.03);
  }

  /* Flex Layout para Tarjeta Wide */
  .bento-flex-content {
    display: flex;
    gap: 32px;
    height: 100%;
    align-items: center;
    transform-style: preserve-3d;
  }
  
  .bento-text-side {
    flex: 1;
    transform-style: preserve-3d;
  }

  .gold-badge {
    position: absolute;
    width: 110px;
    height: 110px;
    background: linear-gradient(135deg, #FFDF73, #D4AF37, #996515);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    font-size: 0.75rem;
    font-weight: 900;
    color: #3b2a00;
    border: 3px solid rgba(255,255,255,0.4);
    box-shadow: 0 16px 36px rgba(212, 175, 55, 0.45), inset 0 4px 10px rgba(255,255,255,0.5);
    text-transform: uppercase;
    line-height: 1.2;
    transform: rotateZ(8deg) translateZ(60px);
  }

  @media (max-width: 768px) {
    .bento-flex-content {
      flex-direction: column;
      align-items: flex-start;
    }
    .bento-guarantee-visual {
      width: 100%;
      margin-top: 20px;
    }
  }
</style>

<script is:inline>
  // Implementación Vanilla JS para Tilt 3D
  function init3DBento() {
    const cards = document.querySelectorAll('.tilt-element');
    
    cards.forEach(card => {
      // Sensibilidad del efecto (mayor = menos rotación)
      const sensitivity = 40; 
      
      card.addEventListener('mousemove', (e) => {
        // Obtener dimensiones y posición de la tarjeta
        const rect = card.getBoundingClientRect();
        
        // Calcular posición del ratón relativa a la tarjeta (en pixeles)
        const x = e.clientX - rect.left;
        const y = e.clientY - rect.top;
        
        // Convertir a porcentajes (-0.5 a 0.5) donde 0,0 es el centro
        const xPct = (x / rect.width) - 0.5;
        const yPct = (y / rect.height) - 0.5;
        
        // Calcular rotación en grados
        const rotateX = -yPct * sensitivity;
        const rotateY = xPct * sensitivity;
        
        // Aplicar transformación
        card.style.transform = `perspective(1000px) rotateX(${rotateX}deg) rotateY(${rotateY}deg) scale3d(1.02, 1.02, 1.02)`;
        card.style.transition = 'transform 0.1s cubic-bezier(0.25, 0.46, 0.45, 0.94)';
      });
      
      card.addEventListener('mouseleave', () => {
        // Restaurar estado original
        card.style.transform = `perspective(1000px) rotateX(0deg) rotateY(0deg) scale3d(1, 1, 1)`;
        card.style.transition = 'transform 0.5s cubic-bezier(0.25, 0.46, 0.45, 0.94)';
      });
    });
  }

  // Ejecutar al cargar
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init3DBento);
  } else {
    init3DBento();
  }
</script>
