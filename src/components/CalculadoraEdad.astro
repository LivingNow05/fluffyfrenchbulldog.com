---
// Calculadora de edad Canina equivalente a Humana
---

<div class="calc-box reveal" id="calculadora-edad">
  <div class="calc-header">
    <svg class="calc-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <circle cx="12" cy="12" r="10"></circle>
      <polyline points="12 6 12 12 16 14"></polyline>
    </svg>
    <div>
      <h4>Calculadora de Edad Canina Equivalente</h4>
      <p>Descubre cuántos años humanos equivale la edad de tu Bulldog Francés Fluffy.</p>
    </div>
  </div>

  <div class="calc-body">
    <div class="calc-inputs">
      <div class="input-group">
        <label for="dog-age">Edad de tu perro (Años)</label>
        <div class="range-container">
          <input type="range" id="dog-age" min="0.5" max="15" step="0.5" value="2.0" />
          <span class="range-val" id="dog-age-val">2.0 años</span>
        </div>
      </div>
    </div>

    <div class="calc-results">
      <div class="result-card">
        <span class="result-label">Equivalencia en Años Humanos</span>
        <div class="result-number">
          <span id="result-human-age">--</span> <span class="unit">años</span>
        </div>
        <p class="result-disclaimer">Calculado según fórmula logarítmica canina para razas pequeñas-medianas.</p>
      </div>
    </div>
  </div>
</div>

<script is:inline>
  (function () {
    const container = document.getElementById('calculadora-edad');
    if (!container) return;

    const ageInput = container.querySelector('#dog-age');
    const ageVal = container.querySelector('#dog-age-val');
    const humanAgeText = container.querySelector('#result-human-age');

    function calculate() {
      const age = parseFloat(ageInput.value);
      ageVal.textContent = age.toFixed(1) + (age === 1 ? ' año' : ' años');

      // Fórmula logarítmica canina moderna (16 * ln(edad) + 31)
      let humanAge = Math.round(16 * Math.log(age) + 31);
      if (age < 1) {
        humanAge = Math.round(age * 15);
      }

      humanAgeText.textContent = humanAge;
    }

    ageInput.addEventListener('input', calculate);
    calculate();
  })();
</script>

<style>
  .calc-box {
    margin: 40px auto;
    max-width: 740px;
  }
  .calc-header {
    display: flex;
    gap: 16px;
    align-items: center;
    border-bottom: 1px solid var(--border);
    padding-bottom: 18px;
    margin-bottom: 20px;
  }
  .calc-header h4 {
    margin: 0 0 2px;
    font-size: 1.22rem;
    font-weight: 700;
    color: var(--ink);
  }
  .calc-header p {
    margin: 0;
    font-size: 0.86rem;
    color: var(--ink-soft);
  }
  .calc-body {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: 28px;
    align-items: center;
  }
  @media (max-width: 640px) {
    .calc-body {
      grid-template-columns: 1fr;
      gap: 20px;
    }
  }
  .calc-inputs {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }
  .input-group {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .input-group label {
    font-size: 0.88rem;
    font-weight: 700;
    color: var(--ink);
  }
  .range-container {
    display: flex;
    gap: 14px;
    align-items: center;
  }
  .range-container input {
    flex-grow: 1;
    accent-color: var(--amber);
    cursor: pointer;
  }
  .range-val {
    font-size: 0.95rem;
    font-weight: 800;
    color: var(--amber);
    min-width: 65px;
    text-align: right;
  }
  .result-label {
    font-size: 0.78rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--ink-soft);
    display: block;
    margin-bottom: 6px;
  }
  .result-number {
    font-size: 2.2rem;
    font-weight: 850;
    color: var(--ink);
    margin-bottom: 8px;
    font-family: var(--font-display);
  }
  .result-number .unit {
    font-size: 1rem;
    font-weight: 600;
    color: var(--ink-soft);
  }
  .result-disclaimer {
    margin: 0;
    font-size: 0.74rem;
    color: var(--ink-soft);
  }
</style>
