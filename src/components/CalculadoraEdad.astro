---
// Calculadora de edad Canina equivalente a Humana
---

<div class="calc-box reveal" id="calculadora-edad">
  <div class="calc-header">
    <svg class="calc-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <circle cx="12" cy="12" r="10"></circle>
      <polyline points="12 6 12 12 16 14"></polyline>
    </svg>
    <div>
      <h4>Calculadora de Edad Canina Equivalente</h4>
      <p>Descubre cuántos años humanos equivale la edad de tu Bulldog Francés Fluffy.</p>
    </div>
  </div>

  <div class="calc-body">
    <div class="calc-inputs">
      <div class="input-group">
        <label for="dog-age">Edad de tu perro (Años)</label>
        <div class="range-container">
          <input type="range" id="dog-age" min="0.5" max="15" step="0.5" value="2.0" />
          <span class="range-val" id="dog-age-val">2.0 años</span>
        </div>
      </div>
    </div>

    <div class="calc-results">
      <div class="result-card">
        <span class="result-label">Equivalencia en Años Humanos</span>
        <div class="result-number">
          <span id="result-human-age">--</span> <span class="unit">años</span>
        </div>
        <p class="result-disclaimer">Calculado según fórmula logarítmica canina para razas pequeñas-medianas.</p>
      </div>
    </div>
  </div>
</div>

<script is:inline>
  (function () {
    const container = document.getElementById('calculadora-edad');
    if (!container) return;

    const ageInput = container.querySelector('#dog-age');
    const ageVal = container.querySelector('#dog-age-val');
    const humanAgeText = container.querySelector('#result-human-age');

    function calculate() {
      const age = parseFloat(ageInput.value);
      ageVal.textContent = age.toFixed(1) + (age === 1 ? ' año' : ' años');

      // Fórmula logarítmica canina moderna (16 * ln(edad) + 31)
      let humanAge = Math.round(16 * Math.log(age) + 31);
      if (age < 1) {
        humanAge = Math.round(age * 15);
      }

      humanAgeText.textContent = humanAge;
    }

    ageInput.addEventListener('input', calculate);
    calculate();
  })();
</script>

<style>
  .calc-box {
    margin: 40px auto;
    max-width: 740px;
    background: rgba(20, 14, 38, 0.92) !important;
    backdrop-filter: blur(24px) !important;
    -webkit-backdrop-filter: blur(24px) !important;
    border: 1px solid rgba(168, 85, 247, 0.35);
    border-radius: 24px;
    padding: 36px;
    box-shadow: 0 20px 50px rgba(0, 0, 0, 0.6), 0 0 35px rgba(168, 85, 247, 0.15);
    transition: border-color 0.3s ease, box-shadow 0.3s ease;
  }
  .calc-box:hover {
    border-color: rgba(192, 132, 252, 0.5);
    box-shadow: 0 24px 60px rgba(0, 0, 0, 0.7), 0 0 45px rgba(168, 85, 247, 0.25);
  }
  :root.light-theme .calc-box {
    background: rgba(255, 255, 255, 0.95) !important;
    border-color: rgba(124, 58, 237, 0.25) !important;
    box-shadow: 0 16px 40px rgba(124, 58, 237, 0.08) !important;
  }
  .calc-header {
    display: flex;
    gap: 16px;
    align-items: center;
    border-bottom: 1px solid rgba(168, 85, 247, 0.2);
    padding-bottom: 20px;
    margin-bottom: 24px;
  }
  :root.light-theme .calc-header {
    border-bottom-color: rgba(124, 58, 237, 0.15);
  }
  .calc-icon {
    width: 36px;
    height: 36px;
    color: #c084fc;
    flex-shrink: 0;
    filter: drop-shadow(0 0 8px rgba(192, 132, 252, 0.5));
  }
  :root.light-theme .calc-icon {
    color: #7c3aed;
    filter: none;
  }
  .calc-header h4 {
    margin: 0 0 4px;
    font-size: 1.25rem;
    font-weight: 800;
    color: var(--ink);
    font-family: var(--font-display);
  }
  .calc-header p {
    margin: 0;
    font-size: 0.88rem;
    color: var(--ink-soft);
  }
  .calc-body {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: 32px;
    align-items: center;
  }
  @media (max-width: 640px) {
    .calc-box {
      padding: 24px;
    }
    .calc-body {
      grid-template-columns: 1fr;
      gap: 24px;
    }
  }
  .calc-inputs {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }
  .input-group {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .input-group label {
    font-size: 0.9rem;
    font-weight: 700;
    color: var(--ink);
  }
  .range-container {
    display: flex;
    gap: 16px;
    align-items: center;
  }
  .range-container input[type="range"] {
    flex-grow: 1;
    accent-color: #c084fc;
    cursor: pointer;
    height: 6px;
    border-radius: 999px;
  }
  .range-val {
    font-size: 1.05rem;
    font-weight: 800;
    color: #c084fc;
    min-width: 70px;
    text-align: right;
    text-shadow: 0 0 10px rgba(192, 132, 252, 0.5);
  }
  :root.light-theme .range-val {
    color: #7c3aed !important;
    text-shadow: none;
  }
  .calc-results {
    background: rgba(13, 9, 26, 0.9);
    border: 1px solid rgba(168, 85, 247, 0.3);
    border-radius: 20px;
    padding: 28px 24px;
    text-align: center;
    box-shadow: inset 0 0 20px rgba(168, 85, 247, 0.1);
  }
  :root.light-theme .calc-results {
    background: rgba(248, 250, 252, 0.9) !important;
    border-color: rgba(124, 58, 237, 0.2) !important;
    box-shadow: none;
  }
  .result-label {
    font-size: 0.78rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--ink-soft);
    display: block;
    margin-bottom: 10px;
  }
  .result-number {
    font-size: 2.8rem;
    font-weight: 900;
    margin-bottom: 8px;
    font-family: var(--font-display);
    line-height: 1;
    background: linear-gradient(135deg, #c084fc 0%, #f59e0b 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    filter: drop-shadow(0 0 12px rgba(192, 132, 252, 0.4));
  }
  :root.light-theme .result-number {
    background: linear-gradient(135deg, #7c3aed 0%, #d97706 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    filter: none;
  }
  .result-number .unit {
    font-size: 1.05rem;
    font-weight: 700;
    background: none;
    -webkit-background-clip: initial;
    -webkit-text-fill-color: var(--ink-soft);
  }
  .result-disclaimer {
    margin: 0;
    font-size: 0.8rem;
    color: var(--ink-soft);
    line-height: 1.45;
  }
</style>
