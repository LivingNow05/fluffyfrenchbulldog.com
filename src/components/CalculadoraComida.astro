---
interface Props {
  variedad?: string;
}

const { variedad = 'general' } = Astro.props;
---

<div class="calc-box reveal" id="calculadora-comida">
  <div class="calc-header">
    <svg class="calc-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"></path>
    </svg>
    <div>
      <h4>Calculadora Nutricional para Bulldog Fluffy</h4>
      <p>Calcula la porción diaria recomendada de alimento holístico o BARF según el peso y edad de tu cachorro.</p>
    </div>
  </div>

  <div class="calc-body">
    <div class="calc-inputs">
      <div class="input-group">
        <label for="dog-weight">Peso de tu Bulldog (kg)</label>
        <div class="range-container">
          <input type="range" id="dog-weight" min="2" max="16" step="0.5" value="10.0" />
          <span class="range-val" id="dog-weight-val">10.0 kg</span>
        </div>
      </div>

      <div class="input-group">
        <label for="dog-activity">Etapa de vida / Actividad</label>
        <select id="dog-activity">
          <option value="cachorro">Cachorro en desarrollo (2 a 8 meses)</option>
          <option value="normal" selected>Adulto Actividad Estándar</option>
          <option value="bajo">Adulto Mayor / Sedentario</option>
          <option value="atleta">Alta Actividad / Reproductor</option>
        </select>
      </div>
    </div>

    <div class="calc-results">
      <div class="result-card">
        <span class="result-label">Porción Diaria Recomendada</span>
        <div class="result-number">
          <span id="result-grams">--</span> <span class="unit">gramos / día</span>
        </div>
        <p class="result-disclaimer" id="result-note">Dividir en 2 a 3 tomas diarias. Basado en alimento Super Premium (3.800 kcal/kg).</p>
      </div>
    </div>
  </div>
</div>

<script is:inline>
  (function () {
    const container = document.getElementById('calculadora-comida');
    if (!container) return;

    const weightInput = container.querySelector('#dog-weight');
    const weightVal = container.querySelector('#dog-weight-val');
    const activitySelect = container.querySelector('#dog-activity');
    const gramsText = container.querySelector('#result-grams');

    function calculate() {
      const weight = parseFloat(weightInput.value);
      weightVal.textContent = weight.toFixed(1) + ' kg';

      // RER Canino = 70 * (peso ^ 0.75)
      const rer = 70 * Math.pow(weight, 0.75);

      let factor = 1.6;
      const activity = activitySelect.value;
      if (activity === 'cachorro') factor = 2.5;
      if (activity === 'bajo') factor = 1.2;
      if (activity === 'atleta') factor = 2.0;

      const der = rer * factor;
      const kcalPerGram = 3.8;
      const grams = Math.round(der / kcalPerGram);

      let current = parseInt(gramsText.textContent) || 0;
      const step = grams > current ? 1 : -1;
      const duration = 200;
      const steps = Math.abs(grams - current);
      if (steps === 0) {
        gramsText.textContent = grams;
        return;
      }
      
      const intervalTime = Math.max(5, Math.min(30, duration / steps));
      const timer = setInterval(() => {
        current += step;
        gramsText.textContent = current;
        if (current === grams) clearInterval(timer);
      }, intervalTime);
    }

    weightInput.addEventListener('input', calculate);
    activitySelect.addEventListener('change', calculate);
    calculate();
  })();
</script>

<style>
  .calc-box {
    margin: 40px auto;
    max-width: 760px;
    background: rgba(20, 14, 38, 0.92) !important;
    backdrop-filter: blur(24px) !important;
    -webkit-backdrop-filter: blur(24px) !important;
    border: 1px solid rgba(168, 85, 247, 0.35);
    border-radius: 24px;
    padding: 36px;
    box-shadow: 0 20px 50px rgba(0, 0, 0, 0.6), 0 0 35px rgba(168, 85, 247, 0.15);
    transition: border-color 0.3s ease, box-shadow 0.3s ease;
  }
  .calc-box:hover {
    border-color: rgba(192, 132, 252, 0.5);
    box-shadow: 0 24px 60px rgba(0, 0, 0, 0.7), 0 0 45px rgba(168, 85, 247, 0.25);
  }
  :root.light-theme .calc-box {
    background: rgba(255, 255, 255, 0.95) !important;
    border-color: rgba(124, 58, 237, 0.25) !important;
    box-shadow: 0 16px 40px rgba(124, 58, 237, 0.08) !important;
  }
  .calc-header {
    display: flex;
    gap: 16px;
    align-items: center;
    border-bottom: 1px solid rgba(168, 85, 247, 0.2);
    padding-bottom: 22px;
    margin-bottom: 28px;
  }
  :root.light-theme .calc-header {
    border-bottom-color: rgba(124, 58, 237, 0.15);
  }
  .calc-icon {
    width: 36px;
    height: 36px;
    color: #c084fc;
    flex-shrink: 0;
    filter: drop-shadow(0 0 8px rgba(192, 132, 252, 0.5));
  }
  :root.light-theme .calc-icon {
    color: #7c3aed;
    filter: none;
  }
  .calc-header h4 {
    margin: 0 0 4px;
    font-size: 1.3rem;
    font-weight: 800;
    color: #f5f3ff;
    font-family: var(--font-display);
  }
  :root.light-theme .calc-header h4 {
    color: #1e1035 !important;
  }
  .calc-header p {
    margin: 0;
    font-size: 0.9rem;
    color: rgba(245, 243, 255, 0.72);
  }
  :root.light-theme .calc-header p {
    color: #5b21b6 !important;
  }
  .calc-body {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: 32px;
    align-items: center;
  }
  @media (max-width: 640px) {
    .calc-box {
      padding: 24px;
    }
    .calc-body {
      grid-template-columns: 1fr;
      gap: 24px;
    }
  }
  .calc-inputs {
    display: flex;
    flex-direction: column;
    gap: 22px;
  }
  .input-group {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .input-group label {
    font-size: 0.9rem;
    font-weight: 700;
    color: #f5f3ff;
  }
  :root.light-theme .input-group label {
    color: #1e1035 !important;
  }
  .range-container {
    display: flex;
    gap: 16px;
    align-items: center;
  }
  .range-container input[type="range"] {
    flex-grow: 1;
    accent-color: #c084fc;
    cursor: pointer;
    height: 6px;
    border-radius: 999px;
  }
  .range-val {
    font-size: 1.05rem;
    font-weight: 800;
    color: #c084fc;
    min-width: 70px;
    text-align: right;
    text-shadow: 0 0 10px rgba(192, 132, 252, 0.5);
  }
  :root.light-theme .range-val {
    color: #7c3aed !important;
    text-shadow: none;
  }
  select {
    padding: 14px 18px;
    border-radius: 14px;
    border: 1px solid rgba(168, 85, 247, 0.3);
    background: rgba(13, 9, 26, 0.8);
    color: #f5f3ff;
    font-size: 0.94rem;
    font-weight: 600;
    cursor: pointer;
    outline: none;
    transition: border-color 0.25s ease, box-shadow 0.25s ease;
  }
  select option {
    background: #140e26;
    color: #f5f3ff;
  }
  :root.light-theme select {
    background: #f8fafc;
    border-color: #cbd5e1;
    color: #1e1035 !important;
  }
  :root.light-theme select option {
    background: #ffffff;
    color: #1e1035;
  }
  select:focus {
    border-color: #c084fc;
    box-shadow: 0 0 16px rgba(192, 132, 252, 0.4);
  }
  .calc-results {
    background: rgba(13, 9, 26, 0.9);
    border: 1px solid rgba(168, 85, 247, 0.3);
    border-radius: 20px;
    padding: 28px 24px;
    text-align: center;
    box-shadow: inset 0 0 20px rgba(168, 85, 247, 0.1);
  }
  :root.light-theme .calc-results {
    background: rgba(248, 250, 252, 0.9) !important;
    border-color: rgba(124, 58, 237, 0.2) !important;
    box-shadow: none;
  }
  .result-label {
    font-size: 0.78rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: rgba(245, 243, 255, 0.75);
    display: block;
    margin-bottom: 10px;
  }
  :root.light-theme .result-label {
    color: #5b21b6 !important;
  }
  .result-number {
    font-size: 2.8rem;
    font-weight: 900;
    margin-bottom: 8px;
    font-family: var(--font-display);
    line-height: 1;
    background: linear-gradient(135deg, #c084fc 0%, #f59e0b 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    filter: drop-shadow(0 0 12px rgba(192, 132, 252, 0.4));
  }
  :root.light-theme .result-number {
    background: linear-gradient(135deg, #7c3aed 0%, #d97706 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    filter: none;
  }
  .result-number .unit {
    font-size: 1.05rem;
    font-weight: 700;
    background: none;
    -webkit-background-clip: initial;
    -webkit-text-fill-color: rgba(245, 243, 255, 0.8);
  }
  :root.light-theme .result-number .unit {
    -webkit-text-fill-color: #5b21b6 !important;
  }
  .result-disclaimer {
    margin: 0;
    font-size: 0.8rem;
    color: rgba(245, 243, 255, 0.65);
    line-height: 1.45;
  }
  :root.light-theme .result-disclaimer {
    color: #5b21b6 !important;
  }
</style>
