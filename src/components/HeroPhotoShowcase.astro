---
// Componente de Showcase Fotográfico Real para el Hero (Sin ilustraciones ni ojos animados)
const varieties = [
  {
    slug: 'fluffy-blue',
    name: 'Fluffy Blue',
    tagline: 'Pelaje Azul Cobalto Afelpado',
    price: '$3,000 USD',
    image: '/images/variedades/fluffy-blue.jpg',
    badge: '👑 Más Codiciado'
  },
  {
    slug: 'fluffy-visual-isabella',
    name: 'Visual Isabella',
    tagline: 'Tono Champagne Sedoso & Ojos Claros',
    price: '$4,500 USD',
    image: '/images/variedades/fluffy-visual-isabella.jpg',
    badge: '✨ Calidad Show'
  },
  {
    slug: 'fluffy-lilac',
    name: 'Fluffy Lilac',
    tagline: 'Matiz Malva Lilac Exclusivo',
    price: '$3,500 USD',
    image: '/images/variedades/fluffy-lilac.jpg',
    badge: '🌟 Edición Limitada'
  },
  {
    slug: 'fluffy-fluffy-cocoa',
    name: 'Fluffy Cocoa',
    tagline: 'Manto Choco Afelpado Intenso',
    price: '$3,200 USD',
    image: '/images/variedades/fluffy-fluffy-cocoa.jpg',
    badge: '💎 Linaje Puro'
  },
  {
    slug: 'fluffy-merle',
    name: 'Fluffy Merlé',
    tagline: 'Patrón Moteado Único e Inimitable',
    price: '$3,800 USD',
    image: '/images/variedades/fluffy-merle.jpg',
    badge: '🔥 Exótico Raro'
  }
];
---

<div class="hero-photo-bento-card" id="hero-photo-card">
  <!-- Tarjeta Header Status -->
  <div class="photo-card-header">
    <span class="showcase-badge" id="hero-card-badge">👑 Más Codiciado</span>
    <span class="showcase-status">🟢 Entrega con Niñera Aérea VIP</span>
  </div>

  <!-- Marco Fotográfico Real con Transición -->
  <div class="photo-showcase-frame">
    <img 
      id="hero-puppy-image" 
      src="/images/variedades/fluffy-blue.jpg" 
      alt="Cachorro Bulldog Francés Fluffy Real" 
      class="hero-puppy-photo"
      loading="eager"
      width="600"
      height="450"
    />
    <div class="photo-overlay-gradient"></div>

    <!-- Overlay Info sobre la Foto -->
    <div class="photo-overlay-info">
      <h3 id="hero-puppy-name">Fluffy Blue</h3>
      <p id="hero-puppy-tagline">Pelaje Azul Cobalto Afelpado</p>
      <span class="photo-price-tag" id="hero-puppy-price">Desde $3,000 USD</span>
    </div>
  </div>

  <!-- Selector Rápido de Fotos por Color -->
  <div class="photo-selector-strip">
    {varieties.map((item, index) => (
      <button 
        type="button" 
        class={`photo-select-btn ${index === 0 ? 'active' : ''}`}
        data-name={item.name}
        data-tagline={item.tagline}
        data-price={`Desde ${item.price}`}
        data-image={item.image}
        data-badge={item.badge}
        aria-label={`Ver variedad ${item.name}`}
      >
        <span class="btn-dot"></span>
        <span>{item.name}</span>
      </button>
    ))}
  </div>

  <!-- Footer de Especificaciones Certificadas -->
  <div class="photo-card-footer">
    <div class="footer-spec-item">
      <span class="spec-icon">📜</span>
      <div>
        <strong>Pedigree AKC / FCI</strong>
        <small>Certificación Oficial</small>
      </div>
    </div>
    <div class="footer-spec-item">
      <span class="spec-icon">🧬</span>
      <div>
        <strong>Test ADN 100%</strong>
        <small>Salud Garantizada 2 Años</small>
      </div>
    </div>
  </div>
</div>

<script>
  function initHeroPhotoSelector() {
    const card = document.getElementById('hero-photo-card');
    if (!card) return;

    const img = card.querySelector('#hero-puppy-image') as HTMLImageElement;
    const nameEl = card.querySelector('#hero-puppy-name');
    const taglineEl = card.querySelector('#hero-puppy-tagline');
    const priceEl = card.querySelector('#hero-puppy-price');
    const badgeEl = card.querySelector('#hero-card-badge');
    const buttons = card.querySelectorAll('.photo-select-btn');

    buttons.forEach((btn) => {
      btn.addEventListener('click', () => {
        buttons.forEach((b) => b.classList.remove('active'));
        btn.classList.add('active');

        const image = btn.getAttribute('data-image');
        const name = btn.getAttribute('data-name');
        const tagline = btn.getAttribute('data-tagline');
        const price = btn.getAttribute('data-price');
        const badge = btn.getAttribute('data-badge');

        if (img && image) {
          img.style.opacity = '0.3';
          img.style.transform = 'scale(0.97)';
          setTimeout(() => {
            img.src = image;
            img.style.opacity = '1';
            img.style.transform = 'scale(1)';
          }, 150);
        }

        if (nameEl && name) nameEl.textContent = name;
        if (taglineEl && tagline) taglineEl.textContent = tagline;
        if (priceEl && price) priceEl.textContent = price;
        if (badgeEl && badge) badgeEl.textContent = badge;
      });
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initHeroPhotoSelector);
  } else {
    initHeroPhotoSelector();
  }
</script>

<style>
  .hero-photo-bento-card {
    position: relative;
    width: 100%;
    max-width: 540px;
    margin: 0 auto;
    background: #131024 !important;
    backdrop-filter: none !important;
    -webkit-backdrop-filter: none !important;
    border: 1px solid rgba(139, 92, 246, 0.2);
    border-radius: 16px;
    padding: 24px;
    box-shadow: 0 16px 40px rgba(0, 0, 0, 0.4);
    display: flex;
    flex-direction: column;
    gap: 18px;
    transition: border-color 0.35s ease, box-shadow 0.35s ease;
  }

  :root.light-theme .hero-photo-bento-card {
    background: #ffffff !important;
    border-color: #e2e8f0;
    box-shadow: 0 12px 32px rgba(30, 27, 75, 0.06);
  }

  .hero-photo-bento-card:hover {
    border-color: rgba(139, 92, 246, 0.6);
    box-shadow: 0 24px 60px rgba(0, 0, 0, 0.6);
  }

  .photo-card-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .showcase-badge {
    font-size: 0.72rem;
    font-weight: 850;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #0c0c0e;
    background: linear-gradient(135deg, #c4b5fd, #8b5cf6);
    padding: 5px 14px;
    border-radius: 999px;
    box-shadow: 0 4px 14px rgba(167, 139, 250, 0.4);
  }

  .showcase-status {
    font-size: 0.76rem;
    font-weight: 700;
    color: #4ade80;
  }

  .photo-showcase-frame {
    position: relative;
    width: 100%;
    height: 310px;
    border-radius: 20px;
    overflow: hidden;
    background: #000;
    box-shadow: 0 12px 32px rgba(0, 0, 0, 0.5);
  }

  .hero-puppy-photo {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.3s ease;
  }

  .photo-overlay-gradient {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, transparent 40%, rgba(9, 10, 12, 0.92) 100%);
    pointer-events: none;
  }

  .photo-overlay-info {
    position: absolute;
    bottom: 16px;
    left: 18px;
    right: 18px;
    z-index: 5;
    color: #ffffff;
  }

  .photo-overlay-info h3 {
    font-family: var(--font-display);
    font-size: 1.4rem;
    font-weight: 800;
    margin: 0 0 2px;
    color: #ffffff;
  }

  .photo-overlay-info p {
    font-size: 0.84rem;
    margin: 0 0 8px;
    color: rgba(255, 255, 255, 0.85);
  }

  .photo-price-tag {
    display: inline-block;
    font-size: 0.82rem;
    font-weight: 800;
    color: #ffffff;
    background: #7c3aed;
    padding: 4px 14px;
    border-radius: 999px;
    box-shadow: none !important;
  }

  .photo-selector-strip {
    display: flex;
    gap: 6px;
    flex-wrap: wrap;
  }

  .photo-select-btn {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 0.76rem;
    font-weight: 750;
    color: var(--moon-soft);
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.12);
    padding: 6px 12px;
    border-radius: 999px;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .photo-select-btn:hover,
  .photo-select-btn.active {
    color: #ffffff !important;
    background: #7c3aed;
    border-color: #8b5cf6;
    box-shadow: none !important;
  }

  .btn-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: currentColor;
  }

  .photo-card-footer {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10px;
    padding-top: 12px;
    border-top: 1px solid rgba(244, 242, 236, 0.1);
  }

  .footer-spec-item {
    display: flex;
    align-items: center;
    gap: 8px;
    background: rgba(255, 255, 255, 0.03);
    padding: 8px 12px;
    border-radius: 14px;
    border: 1px solid rgba(244, 242, 236, 0.08);
  }

  .spec-icon {
    font-size: 1.1rem;
  }

  .footer-spec-item strong {
    display: block;
    font-size: 0.78rem;
    font-weight: 750;
    color: var(--moon);
    line-height: 1.2;
  }

  .footer-spec-item small {
    display: block;
    font-size: 0.68rem;
    color: var(--moon-soft);
  }
</style>
