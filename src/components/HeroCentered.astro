---
// Opción 2: Hero Centrado Tipográfico Minimalista
// Dinastía Bulldog Fluffy — Sistema FLAT (Cero Glassmorfismo)
import WhatsAppIcon from './WhatsAppIcon.astro';
import fluffy from '../data/fluffy.json';

const { site } = fluffy;
const waHref = `https://wa.me/${site.whatsapp.replace(/[^\d]/g, '')}?text=${encodeURIComponent('Hola Dinastía Bulldog Fluffy, me gustaría consultar la disponibilidad de cachorros con pedigree AKC/FCI.')}`;
---

<div class="hero-centered-card" id="hero-centered-content">
  <!-- Insignias AKC / FCI Certificadas -->
  <div class="centered-badge-strip">
    <span class="badge-item">
      <span class="badge-icon">📜</span>
      <span>Pedigree Oficial AKC & FCI</span>
    </span>
    <span class="badge-dot">•</span>
    <span class="badge-item">
      <span class="badge-icon">🧬</span>
      <span>ADN 100% Pura Raza</span>
    </span>
    <span class="badge-dot">•</span>
    <span class="badge-item">
      <span class="badge-icon">🏥</span>
      <span>Garantía Genética 2 Años</span>
    </span>
  </div>

  <!-- Titular Masivo en 4.5rem con Tipografía Outfit -->
  <h1 class="hero-centered-title">
    Perros <span class="title-gradient">Bulldog Francés Fluffy</span>
  </h1>

  <!-- Párrafo Descriptivo Editorial -->
  <p class="hero-centered-lead">
    Especialistas en la crianza de linajes puros de pelaje afelpado exótico. Variedades Fluffy Blue, Visual Isabella, Lilac, Cocoa y Merlé con pedigree internacional y protocolo de entrega VIP con niñera aérea en cabina.
  </p>

  <!-- Botones de Acción Principales -->
  <div class="hero-centered-actions">
    <a class="btn-whatsapp-hero" href={waHref} target="_blank" rel="noopener" aria-label="Consultar por WhatsApp">
      <WhatsAppIcon size={22} class="wa-icon" />
      <span>Consultar Disponibilidad por WhatsApp</span>
    </a>
    <a class="btn-secondary-hero" href="/precios-bulldog-fluffy/">
      <span>Ver Catálogo & Precios 2026</span>
      <span class="arrow">→</span>
    </a>
  </div>

  <!-- MARCO PANORÁMICO PROTAGONISTA DE CACHORROS FLUFFY (Adaptativo Dark / Light) -->
  <div class="hero-showcase-frame animate-on-scroll">
    <div class="showcase-badge">
      <span class="pulse-dot-gold"></span>
      <span>📷 FOTOGRAFÍA REAL DE CRIADERO · EJEMPLARES AKC & FCI</span>
    </div>
    
    <!-- Imagen para Modo Oscuro -->
    <img 
      src="/images/fluffy-showcase-hero.jpg" 
      alt="Cachorros Bulldog Francés Fluffy de Raza Pura" 
      class="showcase-img showcase-img-dark" 
      loading="eager" 
      width="1200" 
      height="675" 
    />
    
    <!-- Imagen para Modo Claro -->
    <img 
      src="/images/fluffy-showcase-hero-light.jpg" 
      alt="Cachorros Bulldog Francés Fluffy de Raza Pura" 
      class="showcase-img showcase-img-light" 
      loading="eager" 
      width="1200" 
      height="675" 
    />

    <!-- Tags de Variedades de Colección Flotantes -->
    <div class="showcase-varieties-bar">
      <span class="v-pill">Fluffy Blue</span>
      <span class="v-pill">Visual Isabella</span>
      <span class="v-pill">Lilac</span>
      <span class="v-pill">Cocoa</span>
      <span class="v-pill">Merlé</span>
    </div>
  </div>

  <!-- Grid de Contador Estadístico -->
  <div class="hero-stats-grid">
    <div class="stat-flat-card">
      <span class="stat-number">5</span>
      <span class="stat-text">Variedades Exóticas</span>
    </div>
    <div class="stat-flat-card">
      <span class="stat-number">+100</span>
      <span class="stat-text">Ciudades con Niñera Aérea</span>
    </div>
    <div class="stat-flat-card">
      <span class="stat-number">100%</span>
      <span class="stat-text">Garantía Genética Certificada</span>
    </div>
    <div class="stat-flat-card">
      <span class="stat-number">+12</span>
      <span class="stat-text">Países con Envíos VIP</span>
    </div>
  </div>
</div>

<style>
  .hero-centered-card {
    position: relative;
    max-width: 960px;
    margin: 0 auto;
    text-align: center;
    background: #131024;
    border: 1px solid rgba(139, 92, 246, 0.2);
    border-radius: 16px;
    padding: 48px 36px;
    box-shadow: 0 16px 40px rgba(0, 0, 0, 0.4);
    backdrop-filter: none !important;
    -webkit-backdrop-filter: none !important;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 28px;
    transition: background 0.3s ease, border-color 0.3s ease, box-shadow 0.3s ease;
  }

  :root.light-theme .hero-centered-card {
    background: #ffffff !important;
    border-color: #e9d5ff !important;
    box-shadow: 0 12px 32px rgba(30, 16, 53, 0.08) !important;
    color: #1e1035 !important;
  }

  .centered-badge-strip {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    background: rgba(139, 92, 246, 0.1);
    border: 1px solid rgba(139, 92, 246, 0.25);
    border-radius: 999px;
    padding: 8px 20px;
    flex-wrap: wrap;
    justify-content: center;
  }

  :root.light-theme .centered-badge-strip {
    background: rgba(147, 51, 234, 0.06) !important;
    border-color: rgba(147, 51, 234, 0.2) !important;
  }

  .badge-item {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--ink);
  }

  :root.light-theme .badge-item {
    color: #1e1035 !important;
  }

  .badge-dot {
    color: var(--brand-bright);
    opacity: 0.6;
    font-size: 0.8rem;
  }

  .hero-centered-title {
    font-family: var(--font-ivar-display);
    font-size: clamp(2.8rem, 6vw, 4.8rem);
    font-weight: 700;
    line-height: 0.95;
    letter-spacing: -0.035em;
    color: var(--ink);
    margin: 0;
  }

  :root.light-theme .hero-centered-title {
    color: #101010 !important;
  }

  .title-gradient {
    color: var(--color-lavender-mist);
    background: linear-gradient(135deg, #b8afda, #d8b4fe, #ffffff);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  :root.light-theme .title-gradient {
    background: linear-gradient(135deg, #7e22ce, #9333ea, #a855f7) !important;
    -webkit-background-clip: text !important;
    -webkit-text-fill-color: transparent !important;
  }

  .hero-centered-lead {
    font-size: clamp(1.05rem, 1.8vw, 1.25rem);
    font-weight: 300;
    line-height: 1.6;
    color: var(--ink-soft);
    max-width: 720px;
    margin: 0;
  }

  :root.light-theme .hero-centered-lead {
    color: #4b5563 !important;
  }

  .hero-centered-actions {
    display: flex;
    gap: 16px;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    width: 100%;
    margin-top: 6px;
  }

  .btn-whatsapp-hero {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    background: var(--whatsapp);
    color: #ffffff;
    font-weight: 600;
    font-size: 1rem;
    padding: 14px 28px;
    border-radius: 9999px;
    text-decoration: none;
    transition: transform 0.25s var(--ease-out), background 0.2s ease;
  }
  .btn-whatsapp-hero:hover {
    box-shadow: 0 12px 30px rgba(22, 163, 74, 0.45);
    color: #ffffff !important;
  }

  .btn-secondary-hero {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: rgba(139, 92, 246, 0.12);
    color: var(--ink);
    border: 1px solid rgba(139, 92, 246, 0.3);
    font-weight: 700;
    font-size: 1rem;
    padding: 16px 28px;
    border-radius: 999px;
    text-decoration: none;
    transition: all 0.25s ease;
  }

  :root.light-theme .btn-secondary-hero {
    background: rgba(147, 51, 234, 0.08) !important;
    border-color: rgba(147, 51, 234, 0.25) !important;
    color: #1e1035 !important;
  }

  .btn-secondary-hero:hover {
    background: rgba(139, 92, 246, 0.22);
    border-color: rgba(139, 92, 246, 0.5);
    transform: translateY(-2px);
  }

  :root.light-theme .btn-secondary-hero:hover {
    background: rgba(147, 51, 234, 0.15) !important;
    border-color: rgba(147, 51, 234, 0.4) !important;
    color: #1e1035 !important;
  }

  .hero-stats-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 16px;
    width: 100%;
    margin-top: 12px;
  }

  .stat-flat-card {
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(139, 92, 246, 0.18);
    border-radius: 14px;
    padding: 20px 14px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
    backdrop-filter: none !important;
    -webkit-backdrop-filter: none !important;
    transition: transform 0.25s ease, border-color 0.25s ease;
  }

  :root.light-theme .stat-flat-card {
    background: #fbf7fe !important;
    border-color: #e9d5ff !important;
  }

  .stat-flat-card:hover {
    transform: translateY(-3px);
    border-color: rgba(139, 92, 246, 0.4);
  }

  :root.light-theme .stat-flat-card:hover {
    border-color: rgba(147, 51, 234, 0.4) !important;
  }

  .stat-number {
    font-family: var(--font-display);
    font-size: 2.2rem;
    font-weight: 850;
    color: var(--brand-bright);
    line-height: 1;
  }

  :root.light-theme .stat-number {
    color: #9333ea !important;
  }

  .stat-text {
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--ink-soft);
    line-height: 1.35;
  }

  :root.light-theme .stat-text {
    color: #5b21b6 !important;
  }

  /* Showcase Frame Protagonista */
  .hero-showcase-frame {
    position: relative;
    width: 100%;
    max-width: 900px;
    margin: 8px 0;
    border-radius: 18px;
    overflow: hidden;
    border: 1px solid rgba(168, 85, 247, 0.25);
    background: #18112e;
    box-shadow: 0 16px 40px rgba(0, 0, 0, 0.35);
    transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1), border-color 0.3s ease, box-shadow 0.3s ease;
  }
  .hero-showcase-frame:hover {
    transform: translateY(-4px) scale(1.008);
    border-color: rgba(168, 85, 247, 0.5);
    box-shadow: 0 24px 50px rgba(168, 85, 247, 0.2);
  }

  .showcase-img {
    width: 100%;
    height: auto;
    display: block;
    object-fit: cover;
    border-radius: 18px;
  }

  .showcase-img-dark {
    display: block;
  }
  .showcase-img-light {
    display: none;
  }

  :root.light-theme .showcase-img-dark {
    display: none !important;
  }
  :root.light-theme .showcase-img-light {
    display: block !important;
  }

  :root.light-theme .hero-showcase-frame {
    background: #ffffff;
    border: 1px solid #e9d5ff;
    box-shadow: 0 16px 40px rgba(30, 16, 53, 0.08);
  }

  .showcase-badge {
    position: absolute;
    top: 14px;
    left: 14px;
    z-index: 5;
    background: rgba(19, 16, 36, 0.85);
    backdrop-filter: blur(10px);
    border: 1px solid rgba(255, 255, 255, 0.15);
    padding: 6px 14px;
    border-radius: 999px;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    color: #e9d5ff;
    display: flex;
    align-items: center;
    gap: 8px;
  }

  :root.light-theme .showcase-badge {
    background: rgba(255, 255, 255, 0.92);
    border: 1px solid #e9d5ff;
    color: #1e1035;
    box-shadow: 0 4px 14px rgba(30, 16, 53, 0.1);
  }

  .showcase-varieties-bar {
    position: absolute;
    bottom: 14px;
    right: 14px;
    z-index: 5;
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  .v-pill {
    background: rgba(19, 16, 36, 0.8);
    backdrop-filter: blur(8px);
    border: 1px solid rgba(168, 85, 247, 0.3);
    color: #f3e8ff;
    font-size: 0.7rem;
    font-weight: 700;
    padding: 4px 10px;
    border-radius: 999px;
  }

  :root.light-theme .v-pill {
    background: rgba(255, 255, 255, 0.9);
    border: 1px solid #c084fc;
    color: #5b21b6;
  }

  @media (max-width: 840px) {
    .hero-centered-card {
      padding: 32px 20px;
      gap: 22px;
    }
    .hero-stats-grid {
      grid-template-columns: repeat(2, 1fr);
    }
    .title-br {
      display: none;
    }
  }

  @media (max-width: 480px) {
    .hero-stats-grid {
      grid-template-columns: 1fr;
    }
    .btn-whatsapp-hero, .btn-secondary-hero {
      width: 100%;
      justify-content: center;
    }
  }
</style>
