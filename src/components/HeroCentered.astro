---
// Opción 2: Hero Centrado Tipográfico Minimalista
// Dinastía Bulldog Fluffy — Sistema FLAT (Cero Glassmorfismo)
import WhatsAppIcon from './WhatsAppIcon.astro';
import fluffy from '../data/fluffy.json';

const { site } = fluffy;
const waHref = `https://wa.me/${site.whatsapp.replace(/[^\d]/g, '')}?text=${encodeURIComponent('Hola Dinastía Bulldog Fluffy, me gustaría consultar la disponibilidad de cachorros con pedigree AKC/FCI.')}`;
---

<div class="hero-centered-card" id="hero-centered-content">
  <!-- Insignias AKC / FCI Certificadas -->
  <div class="centered-badge-strip">
    <span class="badge-item">
      <span class="badge-icon">📜</span>
      <span>Pedigree Oficial AKC & FCI</span>
    </span>
    <span class="badge-dot">•</span>
    <span class="badge-item">
      <span class="badge-icon">🧬</span>
      <span>ADN 100% Pura Raza</span>
    </span>
    <span class="badge-dot">•</span>
    <span class="badge-item">
      <span class="badge-icon">🏥</span>
      <span>Garantía Genética 2 Años</span>
    </span>
  </div>

  <!-- Titular Masivo en 4.5rem con Tipografía Outfit -->
  <h1 class="hero-centered-title">
    Perros <span class="title-gradient">Bulldog Francés Fluffy</span>
  </h1>

  <!-- Párrafo Descriptivo Editorial -->
  <p class="hero-centered-lead">
    Especialistas en la crianza de linajes puros de pelaje afelpado exótico. Variedades Fluffy Blue, Visual Isabella, Lilac, Cocoa y Merlé con pedigree internacional y protocolo de entrega VIP con niñera aérea en cabina.
  </p>

  <!-- Botones de Acción Principales -->
  <div class="hero-centered-actions">
    <a class="btn-whatsapp-hero" href={waHref} target="_blank" rel="noopener" aria-label="Consultar por WhatsApp">
      <WhatsAppIcon size={22} class="wa-icon" />
      <span>Consultar Disponibilidad por WhatsApp</span>
    </a>
    <a class="btn-secondary-hero" href="/precios-bulldog-fluffy/">
      <span>Ver Catálogo & Precios 2026</span>
      <span class="arrow">→</span>
    </a>
  </div>

  <!-- MARCO PROTAGONISTA SHOWCASE DE FOTOGRAFÍA REAL FLUFFY -->
  <div class="hero-showcase-container">
    <div class="showcase-badge-floating">
      <span class="badge-icon">📷</span>
      <span>Fotografía Real de Criadero · Linajes AKC & FCI</span>
    </div>
    
    <div class="showcase-image-wrapper">
      <img
        src="/images/fluffy-showcase-hero.jpg"
        alt="Ejemplares Bulldog Francés Fluffy de Colección"
        class="showcase-img showcase-img-dark"
        width="1200"
        height="675"
        loading="eager"
      />
      <img
        src="/images/fluffy-showcase-hero-light.jpg"
        alt="Ejemplares Bulldog Francés Fluffy de Colección"
        class="showcase-img showcase-img-light"
        width="1200"
        height="675"
        loading="eager"
      />
    </div>

    <div class="showcase-varieties-bar">
      <span class="variety-chip">✨ Fluffy Blue</span>
      <span class="variety-chip">✨ Visual Isabella</span>
      <span class="variety-chip">✨ Fluffy Lilac</span>
      <span class="variety-chip">✨ Cocoa</span>
      <span class="variety-chip">✨ Merlé</span>
    </div>
  </div>

  <!-- Grid de Contador Estadístico -->
  <div class="hero-stats-grid">
    <div class="stat-flat-card">
      <span class="stat-number">5</span>
      <span class="stat-text">Variedades Exóticas</span>
    </div>
    <div class="stat-flat-card">
      <span class="stat-number">+100</span>
      <span class="stat-text">Ciudades con Niñera Aérea</span>
    </div>
    <div class="stat-flat-card">
      <span class="stat-number">100%</span>
      <span class="stat-text">Garantía Genética Certificada</span>
    </div>
    <div class="stat-flat-card">
      <span class="stat-number">+12</span>
      <span class="stat-text">Países con Envíos VIP</span>
    </div>
  </div>
</div>

<style>
  .hero-centered-card {
    position: relative;
    max-width: 960px;
    margin: 0 auto;
    text-align: center;
    background: #131024;
    border: 1px solid rgba(139, 92, 246, 0.2);
    border-radius: 16px;
    padding: 48px 36px;
    box-shadow: 0 16px 40px rgba(0, 0, 0, 0.4);
    backdrop-filter: none !important;
    -webkit-backdrop-filter: none !important;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 28px;
    transition: background 0.3s ease, border-color 0.3s ease, box-shadow 0.3s ease;
  }

  :root.light-theme .hero-centered-card {
    background: #ffffff !important;
    border-color: #e9d5ff !important;
    box-shadow: 0 12px 32px rgba(30, 16, 53, 0.08) !important;
    color: #1e1035 !important;
  }

  .centered-badge-strip {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    background: rgba(139, 92, 246, 0.1);
    border: 1px solid rgba(139, 92, 246, 0.25);
    border-radius: 999px;
    padding: 8px 20px;
    flex-wrap: wrap;
    justify-content: center;
  }

  :root.light-theme .centered-badge-strip {
    background: rgba(147, 51, 234, 0.06) !important;
    border-color: rgba(147, 51, 234, 0.2) !important;
  }

  .badge-item {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--ink);
  }

  :root.light-theme .badge-item {
    color: #1e1035 !important;
  }

  .badge-dot {
    color: var(--brand-bright);
    opacity: 0.6;
    font-size: 0.8rem;
  }

  :root.light-theme .badge-dot {
    color: #9333ea !important;
  }

  .hero-centered-title {
    font-family: var(--font-display);
    font-size: clamp(2.6rem, 5.5vw, 4.5rem);
    font-weight: 800;
    line-height: 1.08;
    letter-spacing: -0.025em;
    color: var(--ink);
    margin: 0;
  }

  :root.light-theme .hero-centered-title {
    color: #1e1035 !important;
  }

  .title-gradient {
    color: var(--brand-bright);
    background: linear-gradient(135deg, #a78bfa, #8b5cf6, #c4b5fd);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  :root.light-theme .title-gradient {
    background: linear-gradient(135deg, #9333ea, #7e22ce, #a855f7) !important;
    -webkit-background-clip: text !important;
    -webkit-text-fill-color: transparent !important;
  }

  .hero-centered-lead {
    font-size: clamp(1.05rem, 1.8vw, 1.25rem);
    line-height: 1.7;
    color: var(--ink-soft);
    max-width: 720px;
    margin: 0;
  }

  :root.light-theme .hero-centered-lead {
    color: #5b21b6 !important;
  }

  .hero-centered-actions {
    display: flex;
    gap: 16px;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    width: 100%;
    margin-top: 6px;
  }

  .btn-whatsapp-hero {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    background: #16a34a !important;
    color: #ffffff !important;
    font-weight: 750;
    font-size: 1.05rem;
    padding: 16px 32px;
    border-radius: 999px;
    text-decoration: none !important;
    box-shadow: 0 8px 24px rgba(22, 163, 74, 0.35);
    transition: transform 0.25s ease, background-color 0.25s ease, box-shadow 0.25s ease;
  }

  .btn-whatsapp-hero:hover {
    background: #15803d !important;
    transform: translateY(-3px) scale(1.02);
    box-shadow: 0 12px 30px rgba(22, 163, 74, 0.45);
    color: #ffffff !important;
  }

  .btn-secondary-hero {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: rgba(139, 92, 246, 0.12);
    color: var(--ink);
    border: 1px solid rgba(139, 92, 246, 0.3);
    font-weight: 700;
    font-size: 1rem;
    padding: 16px 28px;
    border-radius: 999px;
    text-decoration: none;
    transition: all 0.25s ease;
  }

  :root.light-theme .btn-secondary-hero {
    background: rgba(147, 51, 234, 0.08) !important;
    border-color: rgba(147, 51, 234, 0.25) !important;
    color: #1e1035 !important;
  }

  .btn-secondary-hero:hover {
    background: rgba(139, 92, 246, 0.22);
    border-color: rgba(139, 92, 246, 0.5);
    transform: translateY(-2px);
  }

  :root.light-theme .btn-secondary-hero:hover {
    background: rgba(147, 51, 234, 0.15) !important;
    border-color: rgba(147, 51, 234, 0.4) !important;
    color: #1e1035 !important;
  }

  .hero-stats-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 16px;
    width: 100%;
    margin-top: 12px;
  }

  .stat-flat-card {
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(139, 92, 246, 0.18);
    border-radius: 14px;
    padding: 20px 14px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
    backdrop-filter: none !important;
    -webkit-backdrop-filter: none !important;
    transition: transform 0.25s ease, border-color 0.25s ease;
  }

  :root.light-theme .stat-flat-card {
    background: #fbf7fe !important;
    border-color: #e9d5ff !important;
  }

  .stat-flat-card:hover {
    transform: translateY(-3px);
    border-color: rgba(139, 92, 246, 0.4);
  }

  :root.light-theme .stat-flat-card:hover {
    border-color: rgba(147, 51, 234, 0.4) !important;
  }

  .stat-number {
    font-family: var(--font-display);
    font-size: 2.2rem;
    font-weight: 850;
    color: var(--brand-bright);
    line-height: 1;
  }

  :root.light-theme .stat-number {
    color: #9333ea !important;
  }

  .stat-text {
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--ink-soft);
    line-height: 1.35;
  }

  :root.light-theme .stat-text {
    color: #5b21b6 !important;
  }

  @media (max-width: 840px) {
    .hero-centered-card {
      padding: 32px 20px;
      gap: 22px;
    }
    .hero-stats-grid {
      grid-template-columns: repeat(2, 1fr);
    }
    .title-br {
      display: none;
    }
  }

  @media (max-width: 480px) {
    .hero-stats-grid {
      grid-template-columns: 1fr;
    }
    .btn-whatsapp-hero, .btn-secondary-hero {
      width: 100%;
      justify-content: center;
    }
  }

  /* ─── Showcase Protagonista Fotografía Real ─── */
  .hero-showcase-container {
    position: relative;
    width: 100%;
    max-width: 880px;
    margin: 8px 0 12px;
    border-radius: 20px;
    overflow: hidden;
    background: #1a1336;
    border: 1px solid rgba(168, 85, 247, 0.3);
    box-shadow: 0 20px 50px rgba(0, 0, 0, 0.45);
    transition: transform 0.4s ease, border-color 0.3s ease, box-shadow 0.3s ease;
  }
  .hero-showcase-container:hover {
    transform: translateY(-4px);
    border-color: rgba(168, 85, 247, 0.6);
    box-shadow: 0 24px 60px rgba(168, 85, 247, 0.25);
  }

  :root.light-theme .hero-showcase-container {
    background: #fcfaff !important;
    border-color: #e9d5ff !important;
    box-shadow: 0 16px 40px rgba(147, 51, 234, 0.12) !important;
  }

  .showcase-badge-floating {
    position: absolute;
    top: 14px;
    left: 14px;
    z-index: 10;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 7px 14px;
    border-radius: 999px;
    background: rgba(15, 10, 32, 0.85);
    backdrop-filter: blur(12px);
    border: 1px solid rgba(255, 255, 255, 0.18);
    color: #f8fafc;
    font-size: 0.8rem;
    font-weight: 700;
  }

  :root.light-theme .showcase-badge-floating {
    background: rgba(255, 255, 255, 0.92) !important;
    border-color: #e9d5ff !important;
    color: #1e1035 !important;
    box-shadow: 0 4px 14px rgba(30, 16, 53, 0.1);
  }

  .showcase-image-wrapper {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    overflow: hidden;
  }

  .showcase-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .hero-showcase-container:hover .showcase-img {
    transform: scale(1.03);
  }

  .showcase-img-dark {
    display: block !important;
  }
  .showcase-img-light {
    display: none !important;
  }

  :root.light-theme .showcase-img-dark {
    display: none !important;
  }
  :root.light-theme .showcase-img-light {
    display: block !important;
  }

  .showcase-varieties-bar {
    position: absolute;
    bottom: 12px;
    left: 50%;
    transform: translateX(-50%);
    z-index: 10;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 6px;
    width: calc(100% - 24px);
    max-width: 720px;
  }

  .variety-chip {
    padding: 5px 12px;
    border-radius: 999px;
    background: rgba(23, 15, 48, 0.82);
    backdrop-filter: blur(10px);
    border: 1px solid rgba(192, 132, 252, 0.3);
    color: #f3e8ff;
    font-size: 0.76rem;
    font-weight: 700;
  }

  :root.light-theme .variety-chip {
    background: rgba(255, 255, 255, 0.92) !important;
    border-color: #d8b4fe !important;
    color: #5b21b6 !important;
    box-shadow: 0 4px 12px rgba(147, 51, 234, 0.1);
  }

  @media (max-width: 640px) {
    .showcase-badge-floating {
      top: 10px;
      left: 10px;
      font-size: 0.72rem;
      padding: 5px 10px;
    }
    .variety-chip {
      font-size: 0.7rem;
      padding: 4px 8px;
    }
  }
</style>
